# Copy to .env for local use (server.js loads it outside production). Never commit .env.
PORT=8080
PUBLIC_URL=http://localhost:8080
# Required in production
SESSION_SECRET=change-me-to-32-random-bytes
# Where the hall inquiry email goes (to the post)
POST_EMAIL=
# Real mail: smtp://user:pass@host:587 or smtps://... . Empty = write .eml files to DATA_DIR/outbox
SMTP_URL=
MAIL_FROM=
# Database, backups, outbox. Default .data/ (production default /home/data)
DATA_DIR=
# First run only: ALLOW_DEFAULT_ADMIN=1 makes admin/admin. Otherwise ADMIN_PASSWORD, else a random one is printed once.
ALLOW_DEFAULT_ADMIN=
ADMIN_PASSWORD=
