# Copy to .env for local use (server.js loads it outside production). Never commit .env.
PORT=8080
PUBLIC_URL=http://localhost:8080
# Required in production
SESSION_SECRET=change-me-to-32-random-bytes
# Where the hall inquiry email goes (to the post)
POST_EMAIL=
# Real mail: smtp://user:pass@host:587 or smtps://... . Empty = write .eml files to DATA_DIR/outbox
SMTP_URL=
MAIL_FROM=
# Database, backups, outbox. Default .data/ (production default /home/data)
DATA_DIR=
# First run only: ALLOW_DEFAULT_ADMIN=1 makes admin/admin. Otherwise ADMIN_PASSWORD, else a random one is printed once.
ALLOW_DEFAULT_ADMIN=
ADMIN_PASSWORD=
# Production refuses to start with ALLOW_DEFAULT_ADMIN=1 or an ADMIN_PASSWORD under 12 characters.
# Set to 1 ONLY behind a proxy (Azure, nginx) that appends the real client address to X-Forwarded-For.
# Otherwise leave empty: the header is ignored (it can be forged) and the socket address is used for rate limits.
TRUST_PROXY=
# Hall inquiries are deleted automatically after this many days (default 365). Backups can hold a copy for up to 7 days more.
INQUIRY_RETENTION_DAYS=
