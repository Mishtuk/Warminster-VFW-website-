---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VisitBlock from '../components/VisitBlock.astro';
import FoodSnaps from '../components/FoodSnaps.astro';
import { POST, href, photo } from '../lib/site';
import { seed } from '../lib/seed';
import { HALL_PHOTOS } from '../lib/hall-photos';
const hallGallery = JSON.stringify(HALL_PHOTOS.map((p) => ({ src: photo(p.name).src, alt: p.alt, cap: p.cap })));

---
<Base title={`${POST.name}, ${POST.city}, PA`}>
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={`${href('/media/hero-poster-portrait-m.jpg')} 540w, ${href('/media/hero-poster-portrait.jpg')} 1080w`} imagesizes="100vw" href={href('/media/hero-poster-portrait-m.jpg')} media="(max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset={`${href('/media/hero-poster-m.jpg')} 960w, ${href('/media/hero-poster.jpg')} 1920w`} imagesizes="100vw" href={href('/media/hero-poster.jpg')} media="not all and (max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
  </Fragment>
  <Hero />
  <section class="section whats-on" aria-labelledby="on-title">
    <div class="container">
      <h2 id="on-title" class="bars">What's on</h2>
      <div class="on-wrap"><Fragment set:html={seed.featured} /></div>
      <p class="section-foot"><a class="btn" href={href('/events')}>See the full calendar</a></p>
    </div>
  </section>
  <VisitBlock />

  <!-- Food and drink: photos first, then the week's specials on a printed menu card -->
  <section class="section band-paper" aria-labelledby="food-title">
    <div class="container food-grid">
      <FoodSnaps limit={4} sizes="(min-width: 900px) 25vw, 50vw" />
      <div class="menu-card">
        <h2 id="food-title">This week at the bar</h2>
        <p class="menu-note">Drink specials and the kitchen at the post</p>
        <div class="menu-specials"><Fragment set:html={seed.specials} /></div>
        <p class="menu-foot"><a class="btn" href={href('/bar')}>Full menu and hours</a></p>
      </div>
    </div>
  </section>

  <!-- The hall: a rental service, so it gets a big, plain band and one clear action -->
  <section class="section band-stone" aria-labelledby="hall-title">
    <div class="container hall-grid">
      <div class="hall-photos" data-gallery="hall">
        <figure class="snap hall-main" style="--tilt:-0.8deg">
          <img {...photo('hall-07')} sizes="(min-width: 900px) 45vw, 100vw" alt="The hall set with round tables" loading="lazy" decoding="async" fetchpriority="low" />
        </figure>
        <figure class="snap hall-small" style="--tilt:2.2deg">
          <img {...photo('life-60th-tables')} sizes="(min-width: 900px) 20vw, 50vw" alt="Tables dressed for the 60th anniversary dinner" loading="lazy" decoding="async" fetchpriority="low" />
          <figcaption>Set for the 60th anniversary</figcaption>
        </figure>
      </div>
      <div>
        <h2 id="hall-title" class="bars">Rent our hall</h2>
        <p class="hall-blurb">{POST.hallBlurb}</p>
        <ul class="facts">
          {POST.hallFacts.slice(0, 4).map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
        </ul>
        <p style="margin-top:1.25rem"><button type="button" class="btn btn-outline" data-open-gallery="hall">See all {HALL_PHOTOS.length} hall photos</button></p>
        <script type="application/json" data-gallery-list="hall" set:html={hallGallery}></script>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn" href={href('/hall#inquiry')}>Rent the Hall</a>
          <a class="btn btn-outline" href={POST.tel}>Call {POST.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Homage: the namesakes plaque, the six branches and POW/MIA, once -->
  <section class="section band-dark" aria-labelledby="tribute-title">
    <div class="container">
      <div class="plaque">
        <h2 id="tribute-title">The post's namesakes</h2>
        <ul class="namesakes">
          <li><strong>Harry C. Wilson II</strong><span>Died in Vietnam. Buried at Union Cemetery.</span></li>
          <li><strong>Douglas A. Post</strong><span>Died during the Vietnam era. Buried at Whitemarsh Cemetery.</span></li>
        </ul>
        <p style="margin-top:1.75rem">Every Memorial Day the post gathers at its flagpole, then visits both graves.</p>
        <ul class="branches" aria-label="Branches of service">
          <li>Army</li><li>Marine Corps</li><li>Navy</li><li>Air Force</li><li>Space Force</li><li>Coast Guard</li>
        </ul>
        <p class="remembrance"><span class="star" aria-hidden="true"></span>POW/MIA. You are not forgotten.</p>
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="news-title">
    <div class="container-narrow panel">
      <h2 id="news-title" class="bars">From the post</h2>
      <div style="margin-top:1.25rem"><Fragment set:html={seed.newsLatest} /></div>
      <p class="section-foot"><a class="link" href={href('/news')}>All post news</a></p>
    </div>
  </section>

  <Fragment set:html={seed.data} />
</Base>

<style>
  .food-grid, .hall-grid, .on-grid { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4rem); align-items: center; }
  @media (min-width: 900px) {
    .food-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .hall-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .on-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  }

  .food-grid { align-items: start; }
  .menu-specials { margin-top: 1.25rem; }
  /* Home shows four specials; the full list is on /bar. */
  .menu-specials :global(.vfw-special:nth-child(n + 5)) { display: none; }
  .menu-foot { margin-top: 1.5rem; text-align: center; }

  .hall-photos { position: relative; padding-bottom: 2.5rem; }
  .hall-small { position: absolute; right: 0; bottom: 0; width: 44%; }
  .hall-blurb { margin-top: 1rem; font-size: var(--step-1); line-height: 1.5; }
  .hall-grid .facts { margin-top: 1.25rem; }

  .life { display: grid; gap: 1.75rem; }
  @media (min-width: 560px) and (max-width: 899px) { .life { grid-template-columns: 1fr 1fr; } }
</style>

<style is:global>
  /* Home "What's on": filled by the events-featured marker, so these classes are global. */
  .whats-on .on-wrap { margin-top: 1.25rem; }
  .vfw-featured { display: grid; gap: 1.25rem; }
  .vfw-feature, .vfw-card { display: flex; gap: 1.25rem; align-items: center; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-left: 6px solid var(--navy); border-radius: var(--radius); padding: 1.25rem; }
  .vfw-feature { gap: 1.75rem; padding: 1.5rem; }
  .vfw-datebox { flex: none; display: grid; justify-items: center; align-content: center; min-width: 4.5rem; padding: 0.5rem 0.6rem; background: var(--night); color: var(--on-dark); border-bottom: 4px solid var(--brass); border-radius: var(--radius); line-height: 1.1; }
  .vfw-dn { font-family: var(--font-display); font-weight: 700; font-size: 2rem; }
  .vfw-dm, .vfw-dw { font-size: var(--step--1); font-weight: 600; }
  .vfw-feature .vfw-datebox { min-width: 6.5rem; padding: 0.9rem 1rem; }
  .vfw-feature .vfw-dn { font-size: 3.5rem; }
  .vfw-feature-title { font-size: var(--step-3); line-height: 1.15; margin-top: 0.4rem; }
  .vfw-feature-time { margin-top: 0.35rem; font-size: var(--step-1); font-weight: 700; color: var(--red-ink); }
  .vfw-feature-desc { margin-top: 0.5rem; color: var(--ink-2); max-width: 60ch; }
  .vfw-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .vfw-badge { padding: 0.1rem 0.7rem; border-radius: var(--radius); background: var(--night); color: var(--brass); font-size: var(--step--1); font-weight: 700; }
  .vfw-badge-now { background: #7d2528; color: #f4eee3; }
  .vfw-cards { display: grid; gap: 1rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 800px) { .vfw-cards { grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); } }
  .vfw-card { align-items: flex-start; padding: 1rem; }
  .vfw-card > div { display: grid; gap: 0.2rem; }
  .vfw-card-title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.2; }
  .vfw-card .vfw-event-time { color: var(--ink-2); font-weight: 600; }
  .vfw-cat-holiday.vfw-feature, .vfw-cat-holiday.vfw-card { border-left-color: var(--red); }
  @media (max-width: 559px) { .vfw-feature { flex-direction: column; align-items: flex-start; } }
</style>
