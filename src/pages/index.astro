---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VisitBlock from '../components/VisitBlock.astro';
import FoodSnaps from '../components/FoodSnaps.astro';
import BeerTaps from '../components/BeerTaps.astro';
import { POST, href, photo } from '../lib/site';
import { seed } from '../lib/seed';
import { HALL_PHOTOS } from '../lib/hall-photos';
const hallGallery = JSON.stringify(HALL_PHOTOS.map((p) => ({ src: photo(p.name).src, alt: p.alt, cap: p.cap })));

---
<Base title={`${POST.name}, ${POST.city}, PA`}>
  <Fragment slot="head">
    <link rel="preload" as="image" imagesrcset={`${href('/media/hero-poster-portrait-m.avif')} 540w, ${href('/media/hero-poster-portrait.avif')} 1080w`} imagesizes="100vw" href={href('/media/hero-poster-portrait-m.avif')} type="image/avif" media="(max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
    <link rel="preload" as="image" imagesrcset={`${href('/media/hero-poster-m.avif')} 960w, ${href('/media/hero-poster.avif')} 1920w`} imagesizes="100vw" href={href('/media/hero-poster.avif')} type="image/avif" media="not all and (max-width: 700px) and (orientation: portrait)" fetchpriority="high" />
  </Fragment>
  <Hero />
  <section class="section whats-on" aria-labelledby="on-title">
    <div class="container">
      <h2 id="on-title" class="bars">What's going on at the post</h2>
      <div class="on-wrap"><Fragment set:html={seed.featured} /></div>
      <p class="section-foot"><a class="btn" href={href('/events')}>See the full calendar</a></p>
    </div>
    <script>import '../scripts/event-cycle.ts';</script>
  </section>
  <VisitBlock />

  <!-- Food and drink: photos first, then the week's specials on a printed menu card -->
  <section class="section band-paper" aria-labelledby="food-title">
    <div class="container food-grid">
      <BeerTaps />
      <FoodSnaps limit={4} sizes="(min-width: 900px) 25vw, 50vw" />
      <div class="menu-card">
        <h2 id="food-title">This week at the bar</h2>
        <p class="menu-note">Drink specials and the kitchen at the post</p>
        <div class="menu-specials"><Fragment set:html={seed.specials} /></div>
        <p class="menu-foot"><a class="btn" href={href('/bar')}>Full menu and hours</a></p>
      </div>
    </div>
  </section>

  <!-- The hall: a rental service, so it gets a big, plain band and one clear action -->
  <section class="section band-stone" aria-labelledby="hall-title">
    <div class="container hall-grid">
      <div class="hall-photos" data-gallery="hall">
        <figure class="snap hall-main" style="--tilt:-0.8deg">
          <img {...photo('hall-07')} sizes="(min-width: 900px) 45vw, 100vw" alt="The hall set with round tables" loading="lazy" decoding="async" fetchpriority="low" />
        </figure>
        <figure class="snap hall-small" style="--tilt:2.2deg">
          <img {...photo('life-60th-tables')} sizes="(min-width: 900px) 20vw, 50vw" alt="Tables dressed for the 60th anniversary dinner" loading="lazy" decoding="async" fetchpriority="low" />
          <figcaption>Set for the 60th anniversary</figcaption>
        </figure>
      </div>
      <div>
        <h2 id="hall-title" class="bars">Rent our hall</h2>
        <p class="hall-blurb">{POST.hallBlurb}</p>
        <ul class="facts">
          {POST.hallFacts.slice(0, 4).map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
        </ul>
        <p style="margin-top:1.25rem"><button type="button" class="btn btn-outline" data-open-gallery="hall">See all {HALL_PHOTOS.length} hall photos</button></p>
        <script type="application/json" data-gallery-list="hall" set:html={hallGallery}></script>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn" href={href('/hall#inquiry')}>Rent the Hall</a>
          <a class="btn btn-outline" href={POST.tel}>Call {POST.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Homage: the namesakes plaque, the six branches and POW/MIA, once -->
  <section class="section band-dark" aria-labelledby="tribute-title">
    <div class="container">
      <div class="plaque">
        <h2 id="tribute-title">The post's namesakes</h2>
        <ul class="namesakes">
          <li><strong>Harry C. Wilson II</strong><span>Died in Vietnam. Buried at Union Cemetery.</span></li>
          <li><strong>Douglas A. Post</strong><span>Died during the Vietnam era. Buried at Whitemarsh Cemetery.</span></li>
        </ul>
        <p style="margin-top:1.75rem">Every Memorial Day the post gathers at its flagpole, then visits both graves.</p>
        <ul class="branches" aria-label="Branches of service">
          <li>Army</li><li>Marine Corps</li><li>Navy</li><li>Air Force</li><li>Space Force</li><li>Coast Guard</li>
        </ul>
        <p class="remembrance"><span class="star" aria-hidden="true"></span>POW/MIA. You are not forgotten.</p>
      </div>
    </div>
  </section>

  <section class="section band-paper" aria-labelledby="news-title">
    <div class="container-narrow panel">
      <h2 id="news-title" class="bars">From the post</h2>
      <div style="margin-top:1.25rem"><Fragment set:html={seed.newsLatest} /></div>
      <p class="section-foot"><a class="link" href={href('/news')}>All post news</a></p>
    </div>
  </section>

  <Fragment set:html={seed.data} />
</Base>

<style>
  .food-grid, .hall-grid, .on-grid { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4rem); align-items: center; }
  @media (min-width: 900px) {
    .food-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .hall-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .on-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  }

  .food-grid { align-items: start; }
  .menu-specials { margin-top: 1.25rem; }
  /* Home shows four specials; the full list is on /bar. */
  .menu-specials :global(.vfw-special:nth-child(n + 5)) { display: none; }
  .menu-foot { margin-top: 1.5rem; text-align: center; }

  .hall-photos { position: relative; padding-bottom: 2.5rem; }
  .hall-small { position: absolute; right: 0; bottom: 0; width: 44%; }
  .hall-blurb { margin-top: 1rem; font-size: var(--step-1); line-height: 1.5; }
  .hall-grid .facts { margin-top: 1.25rem; }

  .life { display: grid; gap: 1.75rem; }
  @media (min-width: 560px) and (max-width: 899px) { .life { grid-template-columns: 1fr 1fr; } }
</style>

<style is:global>
  /* Home "What's going on": filled by the events-featured marker, so these classes are global. */
  .whats-on .on-wrap { margin-top: 1.5rem; }
  .vfw-featured { display: grid; gap: 1.25rem; }
  .vfw-feature, .vfw-card { background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); }
  .vfw-feature { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 0; padding: 0; box-shadow: var(--shadow); }
  .vfw-feature-photo { margin: 1.25rem; --tilt: -1.2deg; position: relative; align-self: center; }
  /* Bundles of photos (src/scripts/event-cycle.ts): the imgs stack in one grid cell, so the box keeps one size and the fade moves nothing. */
  [data-cycle] { display: grid; }
  [data-cycle] > img { grid-area: 1 / 1; opacity: 0; transition: opacity 1.2s ease-in-out; }
  [data-cycle] > img.is-on { opacity: 1; }
  .vfw-datebox-pin { position: absolute; left: -0.75rem; bottom: -1rem; transform: rotate(1.5deg); box-shadow: var(--shadow); min-width: 5.5rem; }
  .vfw-feature .vfw-datebox { min-width: 5.5rem; padding: 0.8rem 0.9rem 0.9rem; gap: 0.35rem; }
  .vfw-feature .vfw-dn { font-size: 3rem; }
  .vfw-feature-body { min-width: 0; padding: 1.75rem 1.75rem 1.75rem 0.5rem; display: flex; flex-direction: column; gap: 0.6rem; justify-content: center; }
  .vfw-feature-title { font-size: var(--step-3); line-height: 1.15; letter-spacing: 0; }
  .vfw-feature-time { font-size: var(--step-1); font-weight: 700; color: var(--red-ink); }
  .vfw-feature-time:empty { display: none; }
  .vfw-feature-desc { color: var(--ink-2); line-height: 1.55; max-width: 60ch; }
  /* "Tonight" as an inked rubber stamp, like the photo captions. */
  .vfw-feature .vfw-badge-now { border: 2px solid currentColor; background: transparent; color: var(--red-ink); text-transform: uppercase; letter-spacing: 0.04em; transform: rotate(-2deg); font-family: 'Archivo', 'Archivo Fallback', sans-serif; font-stretch: 62%; font-weight: 800; font-size: var(--step-0); }
  .vfw-feature-more { align-self: flex-start; min-height: 44px; }
  .vfw-cards { display: grid; gap: 1rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 1100px) { .vfw-cards { grid-template-columns: 1fr 1fr; } }
  .vfw-card { display: flex; gap: 1.1rem; align-items: center; padding: 1.1rem; }
  .vfw-card-photo { flex: none; position: relative; display: grid; width: 12rem; aspect-ratio: 4 / 3; overflow: hidden; background: var(--stone); border: 4px solid var(--snap); box-shadow: var(--shadow); transform: rotate(var(--tilt, -1deg)); }
  .vfw-card-thumb { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
  .vfw-cards li:nth-child(even) .vfw-card-photo { --tilt: 1.2deg; }
  /* One plain column: badge, title, time. Undo the events-list grid placement that .vfw-event-time carries. */
  .vfw-card > div { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; min-width: 0; padding-top: 0.15rem; }
  .vfw-card .vfw-badge { order: 0; }
  .vfw-card-title a { color: inherit; text-decoration: none; }
  .vfw-card-title a:hover { text-decoration: underline; }
  .vfw-card-title { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.25; text-wrap: balance; }
  .vfw-card .vfw-event-time { grid-row: auto; grid-column: auto; color: var(--ink-2); font-weight: 600; line-height: 1.35; text-wrap: balance; }
  .vfw-cat-holiday.vfw-feature, .vfw-cat-holiday.vfw-card { border-top: 4px solid var(--red); }
  :root[data-theme='dark'] .vfw-feature-photo img, :root[data-theme='dark'] .vfw-card-thumb { filter: brightness(0.92); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vfw-feature-photo img, :root:not([data-theme='light']) .vfw-card-thumb { filter: brightness(0.92); }
  }
  @media (max-width: 559px) {
    .vfw-feature { grid-template-columns: 1fr; }
    .vfw-feature-photo { margin: 0.75rem; --tilt: 0deg; }
    .vfw-feature .vfw-datebox-pin { flex-direction: row; align-items: baseline; gap: 0.6rem; min-width: 0; padding: 0.6rem 1rem 0.7rem; bottom: -0.9rem; left: 0.5rem; }
    .vfw-feature .vfw-datebox-pin .vfw-dn { font-size: 2.4rem; }
    .vfw-feature-body { padding: 1.5rem 1.1rem 1.25rem; }
    .vfw-feature-photo img { aspect-ratio: 3 / 2; }
    .vfw-card { flex-wrap: wrap; }
    .vfw-card-photo { width: 100%; aspect-ratio: 16 / 9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vfw-card-photo, .vfw-datebox-pin, .vfw-feature .vfw-badge-now { transform: none; }
    [data-cycle] > img { transition: none; }
  }
</style>
