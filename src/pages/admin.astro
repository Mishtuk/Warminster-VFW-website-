---
// Post admin. A static page with no secrets: signed-out visitors see the sign-in form, and every read or save goes to /api/admin/*,
// where server.js checks the session cookie. Plain on purpose: big text, big buttons, one thing per screen (volunteers use it).
const NAV = [['dashboard', 'Dashboard'], ['events', 'Events'], ['specials', 'Drink specials'], ['menu', 'Food menu'], ['news', 'News'], ['inquiries', 'Hall inquiries'], ['account', 'Account']];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | VFW Post 6493</title>
    <style is:global>
      @view-transition { navigation: auto; }
      :root { --ink: #1a1d21; --muted: #4a525c; --bg: #f3f2ee; --card: #fff; --line: #b9bcc0; --accent: #1f3a5f; --accent-ink: #fff; --bad: #8a1c1c; --ok: #1d5a2c; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 19px/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      h1 { font-size: 2rem; margin: 0 0 .5rem; line-height: 1.2; }
      h2 { font-size: 1.4rem; margin: 0 0 .75rem; }
      a { color: var(--accent); }
      [hidden] { display: none !important; }
      .wrap { display: grid; grid-template-columns: 15rem 1fr; min-height: 100vh; }
      .side { background: var(--accent); color: var(--accent-ink); padding: 1rem; }
      .side strong { display: block; font-size: 1.15rem; margin-bottom: 1rem; }
      .side a { display: block; color: var(--accent-ink); text-decoration: none; padding: .7rem .8rem; min-height: 44px; border-radius: 6px; font-weight: 600; }
      .side a[aria-current='page'] { background: #fff; color: var(--accent); }
      .side a:focus-visible, .btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid #e0a100; outline-offset: 2px; }
      .main { padding: 1.5rem; max-width: 60rem; width: 100%; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1.25rem; margin: 0 0 1.25rem; }
      label { display: block; font-weight: 600; margin: 0 0 1rem; }
      input[type=text], input[type=password], input[type=date], input[type=time], input[type=number], select, textarea {
        display: block; width: 100%; min-height: 48px; margin-top: .3rem; padding: .55rem .7rem; font: inherit; color: inherit; background: #fff; border: 2px solid #6b7480; border-radius: 6px; }
      textarea { min-height: 8rem; }
      label.check { display: flex; gap: .75rem; align-items: center; font-weight: 600; min-height: 44px; }
      input[type=checkbox] { width: 28px; height: 28px; flex: none; }
      .btn { font: inherit; font-weight: 700; min-height: 48px; padding: .5rem 1.1rem; border-radius: 6px; border: 2px solid var(--accent); background: var(--accent); color: var(--accent-ink); cursor: pointer; }
      .btn.alt { background: #fff; color: var(--accent); }
      .btn.danger { background: #fff; color: var(--bad); border-color: var(--bad); }
      .row { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
      .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0 1rem; }
      .item { display: flex; flex-wrap: wrap; gap: .75rem 1rem; justify-content: space-between; align-items: center; padding: .9rem 0; border-top: 1px solid var(--line); }
      .item:first-child { border-top: 0; }
      .item .what { flex: 1 1 18rem; min-width: 0; overflow-wrap: anywhere; }
      .meta { color: var(--muted); font-size: .95rem; }
      .badge { display: inline-block; font-size: .85rem; font-weight: 700; padding: .1rem .5rem; border-radius: 4px; background: #e6e0cc; color: #3b3320; margin-left: .4rem; }
      .badge.new { background: #dbe7f5; color: #12304f; }
      .err { color: var(--bad); font-weight: 700; }
      .ok { color: var(--ok); font-weight: 700; }
      .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
      .tile { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1rem; }
      .tile b { display: block; font-size: 2rem; line-height: 1.1; }
      .chart { width: 100%; height: auto; display: block; }
      .chart text { font-size: 11px; fill: #3b4048; }
      .gate { max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
      .menu-section { border: 2px solid var(--line); border-radius: 8px; padding: 1rem; margin-bottom: 1rem; background: #fafaf7; }
      .menu-item { border-top: 1px solid var(--line); padding-top: .75rem; margin-top: .75rem; }
      ol.top { padding-left: 1.4rem; margin: 0; }
      .toast { position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); background: #1a1d21; color: #fff; padding: .75rem 1.25rem; border-radius: 8px; z-index: 9; }
      @media (max-width: 800px) {
        .wrap { grid-template-columns: 1fr; }
        .side { display: flex; flex-wrap: wrap; gap: .25rem; align-items: center; }
        .side strong { width: 100%; margin: 0; }
        .side a { padding: .6rem .7rem; }
        .main { padding: 1rem; }
      }
    </style>
  </head>
  <body>
    <div class="gate" id="gate" hidden>
      <form class="card" id="login" novalidate>
        <h1>Post 6493 admin</h1>
        <label>Username <input type="text" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required /></label>
        <label>Password <input type="password" name="password" autocomplete="current-password" required /></label>
        <p class="err" id="login-err" role="alert" hidden></p>
        <button class="btn" type="submit">Sign in</button>
      </form>
      <p><a href="/">Back to the website</a></p>
    </div>

    <div class="wrap" id="app" hidden>
      <nav class="side" aria-label="Admin sections">
        <strong>VFW Post 6493 admin</strong>
        {NAV.map(([id, label]) => <a href={`#${id}`} data-view={id}>{label}</a>)}
        <a href="/" target="_blank" rel="noopener">View the website</a>
      </nav>
      <main class="main" id="main" tabindex="-1">
        <p class="card err" id="default-warning" hidden>The password is still the default (admin). Please change it under Account.</p>
        <section data-section="dashboard"></section>
        <section data-section="events" hidden></section>
        <section data-section="specials" hidden></section>
        <section data-section="menu" hidden></section>
        <section data-section="news" hidden></section>
        <section data-section="inquiries" hidden></section>
        <section data-section="account" hidden></section>
      </main>
    </div>
    <div class="toast" id="toast" role="status" hidden></div>

    <script is:inline>
      const $ = (s, r = document) => r.querySelector(s);
      const h = (tag, props, ...kids) => {
        const el = document.createElement(tag);
        for (const [k, v] of Object.entries(props || {})) {
          if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
          else if (k === 'value' || k === 'checked') el[k] = v;
          else if (v !== false && v != null) el.setAttribute(k, v === true ? '' : v);
        }
        for (const kid of kids.flat()) if (kid != null && kid !== false) el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
        return el;
      };
      const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      const ERR = { title: 'Please enter a title.', date: 'Pick a valid date.', start: 'Check the start time.', end: 'Check the end time.', category: 'Pick a category.', recurring: 'Pick how it repeats.',
        label: 'Please enter a name.', period: 'Pick a period.', weekday: 'Pick the day of the week.', range: 'The end date is before the start date.', body: 'Please write the news text.',
        section_name: 'Every menu section needs a name.', item_name: 'Every menu item needs a name.', signed_out: 'Please sign in again.', origin: 'Reload the page and try again.',
        current: 'The current password is not right.', too_short: 'The new password needs at least 10 characters.', too_easy: 'Pick a harder password.', same: 'That is the same as the old password.',
        too_long: 'That password is too long.', rate: 'Too many tries. Wait a little and try again.' };
      const money = (n) => Number(n).toLocaleString('en-US');
      const dayLabel = (d) => (d ? new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '');
      let S = null; // server state

      function toast(msg) { const t = $('#toast'); t.textContent = msg; t.hidden = false; clearTimeout(toast.t); toast.t = setTimeout(() => (t.hidden = true), 3500); }
      async function api(method, path, body) {
        const r = await fetch('/api/' + path, { method, credentials: 'same-origin', headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
        const data = await r.json().catch(() => ({}));
        if (r.status === 401 && path !== 'login') showLogin();
        return { ok: r.ok, status: r.status, data };
      }
      const say = (r) => r.data.message || ERR[r.data.error] || 'Something went wrong. Try again.';

      // ---------- sign in ----------
      function showLogin() { $('#app').hidden = true; $('#gate').hidden = false; }
      $('#login').addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.target, err = $('#login-err');
        err.hidden = true;
        const r = await api('POST', 'login', { username: f.username.value, password: f.password.value });
        if (!r.ok) { err.textContent = say(r); err.hidden = false; return; }
        f.password.value = '';
        start();
      });

      // ---------- generic list + form for events, specials and news ----------
      const OPT = (a) => a.map((x) => (Array.isArray(x) ? x : [x, x]));
      const CFG = {
        events: { one: 'event', add: 'Add an event', fields: [
          ['title', 'Title', 'text'], ['date', 'Date (first date, if it repeats)', 'date'], ['start', 'Start time (optional)', 'time'], ['end', 'End time (optional)', 'time'],
          ['category', 'Category', 'select', OPT(['Bar', 'Post', 'Auxiliary', 'Community', 'Holiday'])],
          ['recurring', 'Repeats', 'select', [['none', 'Does not repeat'], ['weekly', 'Every week on the same weekday'], ['monthly', 'Every month on the same date'], ['monthly_weekday', 'Every month on the same weekday (like the 2nd Tuesday)']]],
          ['description', 'Description (optional)', 'textarea'], ['enabled', 'Show on the website', 'check']],
          blank: { title: '', date: '', start: '', end: '', category: 'Post', recurring: 'none', description: '', enabled: true },
          line: (e) => e.title, sub: (e) => [dayLabel(e.date), e.start && e.start + (e.end ? ' to ' + e.end : ''), e.category, { none: '', weekly: 'repeats weekly', monthly: 'repeats monthly', monthly_weekday: 'repeats monthly by weekday' }[e.recurring]].filter(Boolean).join(' · ') },
        specials: { one: 'drink special', add: 'Add a drink special', fields: [
          ['label', 'Name of the special', 'text'], ['price', 'Price (as you want it shown, optional)', 'text'], ['description', 'Description (optional)', 'textarea'],
          ['period', 'How often', 'select', [['daily', 'Daily'], ['weekly', 'Weekly'], ['monthly', 'Monthly'], ['seasonal', 'Seasonal']]],
          ['weekday', 'Which day of the week', 'select', DAYS.map((d, i) => [String(i), d]), (v) => v.period === 'weekly'],
          ['start', 'Starts on (optional)', 'date'], ['end', 'Ends on (optional)', 'date'], ['enabled', 'Show on the website', 'check']],
          blank: { label: '', price: '', description: '', period: 'weekly', weekday: '5', start: '', end: '', enabled: true },
          line: (s) => s.label + (s.price ? ' · ' + s.price : ''), sub: (s) => [s.period === 'weekly' ? 'Every ' + DAYS[s.weekday] : s.period, s.start && 'from ' + dayLabel(s.start), s.end && 'until ' + dayLabel(s.end)].filter(Boolean).join(' · ') },
        news: { one: 'news item', add: 'Add a news item', fields: [
          ['title', 'Headline', 'text'], ['date', 'Date', 'date'], ['body', 'News text (leave a blank line between paragraphs)', 'textarea'], ['enabled', 'Show on the website', 'check']],
          blank: { title: '', date: '', body: '', enabled: true }, line: (n) => n.title, sub: (n) => dayLabel(n.date) },
      };
      const TITLES = { events: 'Events', specials: 'Drink specials', news: 'News' };

      function field(f, v) {
        const [k, label, type, opts] = f;
        if (type === 'check') return h('label', { class: 'check' }, h('input', { type: 'checkbox', name: k, checked: !!v[k] }), label);
        if (type === 'textarea') return h('label', {}, label, h('textarea', { name: k, value: v[k] ?? '' }));
        if (type === 'select') return h('label', { 'data-k': k }, label, h('select', { name: k }, opts.map(([val, text]) => h('option', { value: val, selected: String(v[k]) === val }, text))));
        return h('label', {}, label, h('input', { type, name: k, value: v[k] ?? '' }));
      }
      function renderCrud(name) {
        const c = CFG[name], sec = $(`[data-section=${name}]`), items = S[name];
        const list = h('div', { class: 'card' }, items.length ? items.map((it) => h('div', { class: 'item' },
          h('div', { class: 'what' }, h('strong', {}, c.line(it)), !it.enabled && h('span', { class: 'badge' }, 'Hidden'), h('div', { class: 'meta' }, c.sub(it))),
          h('div', { class: 'row' },
            h('button', { class: 'btn alt', type: 'button', onclick: () => edit(it) }, 'Edit'),
            h('button', { class: 'btn alt', type: 'button', onclick: () => save({ ...it, enabled: !it.enabled }, it.enabled ? 'Hidden from the website.' : 'Showing on the website.') }, it.enabled ? 'Hide' : 'Show'),
            h('button', { class: 'btn danger', type: 'button', onclick: () => remove(it) }, 'Delete')))) : h('p', {}, 'Nothing here yet.'));
        const box = h('div');
        sec.replaceChildren(h('h1', {}, TITLES[name]), h('p', {}, h('button', { class: 'btn', type: 'button', onclick: () => edit(null) }, c.add)), box, list);

        async function save(v, msg) {
          const r = await api('PUT', `admin/${name}/${v.id || 'new'}`, v);
          if (!r.ok) return say(r);
          S[name] = r.data.items; renderCrud(name); toast(msg || 'Saved.'); return null;
        }
        async function remove(it) {
          if (!confirm(`Delete this ${c.one}? This cannot be undone. (Use Hide to keep it but not show it.)`)) return;
          const r = await api('DELETE', `admin/${name}/${it.id}`);
          if (r.ok) { S[name] = r.data.items; renderCrud(name); toast('Deleted.'); } else toast(say(r));
        }
        function edit(it) {
          const v = it || { ...c.blank };
          const form = h('form', { class: 'card', novalidate: true });
          const err = h('p', { class: 'err', role: 'alert', hidden: true });
          const rows = c.fields.map((f) => field(f, v));
          const sync = () => c.fields.forEach((f, i) => { if (f[4]) rows[i].hidden = !f[4]({ period: form.period?.value }); });
          form.append(h('h2', {}, it ? `Edit this ${c.one}` : c.add), ...rows, err,
            h('div', { class: 'row' }, h('button', { class: 'btn', type: 'submit' }, 'Save'), h('button', { class: 'btn alt', type: 'button', onclick: () => box.replaceChildren() }, 'Cancel')));
          form.addEventListener('change', sync);
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const out = { id: v.id };
            for (const f of c.fields) out[f[0]] = f[2] === 'check' ? form[f[0]].checked : form[f[0]].value;
            const m = await save(out);
            if (m) { err.textContent = m; err.hidden = false; }
          });
          box.replaceChildren(form); sync();
          form.scrollIntoView({ block: 'start' }); form.querySelector('input,select,textarea').focus();
        }
      }

      // ---------- food menu ----------
      function renderMenu() {
        const sec = $('[data-section=menu]'), M = S.menu;
        const bind = (obj, key) => (e) => { obj[key] = e.target.type === 'checkbox' ? e.target.checked : e.target.value; };
        const draw = () => {
          const err = h('p', { class: 'err', role: 'alert', hidden: true });
          sec.replaceChildren(
            h('h1', {}, 'Food menu'),
            h('p', {}, 'Make sections (like Appetizers), then add items. Turn off "Available" to hide an item without deleting it. Prices are text, so write them how you want them shown.'),
            h('label', {}, 'Kitchen hours (shown above the menu)', h('input', { type: 'text', value: M.hours, oninput: bind(M, 'hours') })),
            M.sections.map((s, si) => h('div', { class: 'menu-section' },
              h('label', {}, 'Section name', h('input', { type: 'text', value: s.name, oninput: bind(s, 'name') })),
              s.items.map((it, ii) => h('div', { class: 'menu-item' },
                h('div', { class: 'grid2' },
                  h('label', {}, 'Item name', h('input', { type: 'text', value: it.name, oninput: bind(it, 'name') })),
                  h('label', {}, 'Price', h('input', { type: 'text', value: it.price, oninput: bind(it, 'price') }))),
                h('label', {}, 'Description (optional)', h('input', { type: 'text', value: it.description, oninput: bind(it, 'description') })),
                h('div', { class: 'row' },
                  h('label', { class: 'check' }, h('input', { type: 'checkbox', checked: it.available, onchange: bind(it, 'available') }), 'Available'),
                  h('button', { class: 'btn danger', type: 'button', onclick: () => { s.items.splice(ii, 1); draw(); } }, 'Remove item')))),
              h('div', { class: 'row' },
                h('button', { class: 'btn alt', type: 'button', onclick: () => { s.items.push({ name: '', price: '', description: '', available: true }); draw(); } }, 'Add an item'),
                h('button', { class: 'btn danger', type: 'button', onclick: () => { if (confirm('Remove this whole section and its items?')) { M.sections.splice(si, 1); draw(); } } }, 'Remove section')))),
            h('p', {}, h('button', { class: 'btn alt', type: 'button', onclick: () => { M.sections.push({ name: '', items: [] }); draw(); } }, 'Add a section')),
            err,
            h('p', {}, h('button', { class: 'btn', type: 'button', onclick: async () => {
              const r = await api('PUT', 'admin/menu', M);
              if (!r.ok) { err.textContent = say(r); err.hidden = false; return; }
              S.menu = r.data.menu; renderMenu(); toast('Menu saved.');
            } }, 'Save the menu')));
        };
        draw();
      }

      // ---------- hall inquiries ----------
      async function renderInquiries() {
        const sec = $('[data-section=inquiries]');
        const r = await api('GET', 'admin/inquiries');
        if (!r.ok) return;
        const list = r.data.inquiries;
        sec.replaceChildren(h('h1', {}, 'Hall inquiries'), h('p', {}, 'Messages from the hall rental form. They are also emailed to the post.'),
          list.length ? list.map((q) => h('div', { class: 'card' },
            h('h2', {}, q.name, h('span', { class: q.handled ? 'badge' : 'badge new' }, q.handled ? 'Handled' : 'New')),
            h('p', { class: 'meta' }, 'Received ' + new Date(q.at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) + (q.emailed ? '' : ' · the email to the post did not go out')),
            h('p', {}, q.phone && h('span', {}, 'Phone: ', h('a', { href: 'tel:' + q.phone.replace(/[^\d+]/g, '') }, q.phone), h('br')), q.email && h('span', {}, 'Email: ', h('a', { href: 'mailto:' + q.email }, q.email), h('br')),
              q.event_date && h('span', {}, 'Event date: ' + dayLabel(q.event_date), h('br')), q.event_type && h('span', {}, 'Event type: ' + q.event_type, h('br')), q.guests && h('span', {}, 'Guests: ' + q.guests)),
            q.message && h('p', { style: 'white-space:pre-wrap' }, q.message),
            h('div', { class: 'row' },
              h('button', { class: 'btn alt', type: 'button', onclick: async () => { await api('PUT', 'admin/inquiries/' + q.id, { handled: !q.handled }); renderInquiries(); } }, q.handled ? 'Mark as new' : 'Mark as handled'),
              h('button', { class: 'btn danger', type: 'button', onclick: async () => { if (confirm('Delete this inquiry for good?')) { await api('DELETE', 'admin/inquiries/' + q.id); renderInquiries(); } } }, 'Delete')))) : h('div', { class: 'card' }, 'No inquiries yet.'));
      }

      // ---------- dashboard ----------
      function chart(series) {
        const W = 640, H = 220, L = 40, B = 24, T = 10, R = 8;
        const max = Math.max(4, ...series.map((p) => p.n)), top = Math.ceil(max / 4) * 4;
        const x = (i) => L + (series.length < 2 ? 0 : (i * (W - L - R)) / (series.length - 1)), y = (n) => T + (H - T - B) * (1 - n / top);
        const pts = series.map((p, i) => `${x(i).toFixed(1)},${y(p.n).toFixed(1)}`).join(' ');
        const ns = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(ns, 'svg');
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.setAttribute('class', 'chart'); svg.setAttribute('role', 'img');
        svg.setAttribute('aria-label', `Visitors per day, highest ${max}`);
        const grid = [0, 1, 2, 3, 4].map((i) => { const v = (top / 4) * i; return `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" stroke="#d6d8da"/><text x="${L - 6}" y="${y(v) + 4}" text-anchor="end">${v}</text>`; }).join('');
        const lab = (i, a) => `<text x="${x(i)}" y="${H - 6}" text-anchor="${a}">${series[i].day.slice(5)}</text>`;
        svg.innerHTML = grid + `<polyline points="${pts}" fill="none" stroke="#1f3a5f" stroke-width="3" stroke-linejoin="round"/>` + (series.length ? lab(0, 'start') + lab(series.length - 1, 'end') : '');
        return svg;
      }
      async function renderDashboard(range = '30d') {
        const sec = $('[data-section=dashboard]');
        const r = await api('GET', 'admin/stats?range=' + range);
        if (!r.ok) return;
        const d = r.data;
        const pick = h('select', { 'aria-label': 'Time range', onchange: (e) => renderDashboard(e.target.value) }, [['7d', 'Last 7 days'], ['30d', 'Last 30 days'], ['90d', 'Last 90 days'], ['365d', 'Last year']].map(([v, t]) => h('option', { value: v, selected: v === d.range }, t)));
        const tile = (n, t) => h('div', { class: 'tile' }, h('b', {}, money(n)), t);
        const top = (items, key, empty) => (items.length ? h('ol', { class: 'top' }, items.map((i) => h('li', {}, `${i[key]} (${money(i.n)})`))) : h('p', { class: 'meta' }, empty));
        sec.replaceChildren(h('h1', {}, 'Dashboard'),
          h('label', {}, 'Show', pick),
          h('div', { class: 'tiles' }, tile(d.visitors, 'Visitors'), tile(d.views, 'Page views'), tile(d.inquiries.inRange, 'Hall inquiries'), tile(d.inquiries.new, 'Inquiries not handled yet')),
          h('div', { class: 'card' }, h('h2', {}, 'Visitors per day'), chart(d.series), h('p', { class: 'meta' }, 'Counted without cookies. Your own visits while signed in are not counted.')),
          h('div', { class: 'grid2' }, h('div', { class: 'card' }, h('h2', {}, 'Top pages'), top(d.pages, 'path', 'No visits counted yet.')),
            h('div', { class: 'card' }, h('h2', {}, 'Where visitors came from'), top(d.referrers, 'host', 'No referring sites yet.'))));
      }

      // ---------- account ----------
      function renderAccount() {
        const sec = $('[data-section=account]');
        const err = h('p', { class: 'err', role: 'alert', hidden: true });
        const form = h('form', { class: 'card', novalidate: true },
          h('h2', {}, 'Change the password'),
          h('label', {}, 'Current password', h('input', { type: 'password', name: 'current', autocomplete: 'current-password' })),
          h('label', {}, 'New password (at least 10 characters)', h('input', { type: 'password', name: 'password', autocomplete: 'new-password' })),
          h('label', {}, 'New password again', h('input', { type: 'password', name: 'again', autocomplete: 'new-password' })),
          err, h('button', { class: 'btn', type: 'submit' }, 'Change password'));
        form.addEventListener('submit', async (e) => {
          e.preventDefault(); err.hidden = true;
          if (form.password.value !== form.again.value) { err.textContent = 'The two new passwords are not the same.'; err.hidden = false; return; }
          const r = await api('POST', 'admin/password', { current: form.current.value, password: form.password.value });
          if (!r.ok) { err.textContent = say(r); err.hidden = false; return; }
          form.reset(); $('#default-warning').hidden = true; toast('Password changed.');
        });
        sec.replaceChildren(h('h1', {}, 'Account'), h('p', {}, 'Signed in as ' + S.user + '.'), form,
          h('button', { class: 'btn alt', type: 'button', onclick: async () => { await api('POST', 'logout'); location.reload(); } }, 'Sign out'));
      }

      // ---------- navigation ----------
      const VIEWS = { dashboard: () => renderDashboard(), events: () => renderCrud('events'), specials: () => renderCrud('specials'), menu: renderMenu, news: () => renderCrud('news'), inquiries: renderInquiries, account: renderAccount };
      function show() {
        const v = VIEWS[location.hash.slice(1)] ? location.hash.slice(1) : 'dashboard';
        document.querySelectorAll('[data-section]').forEach((s) => (s.hidden = s.dataset.section !== v));
        document.querySelectorAll('.side [data-view]').forEach((a) => (a.dataset.view === v ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
        VIEWS[v]();
      }
      async function start() {
        const r = await api('GET', 'admin/state');
        if (!r.ok) return showLogin();
        S = r.data;
        $('#gate').hidden = true; $('#app').hidden = false;
        $('#default-warning').hidden = !S.defaultPassword;
        show();
      }
      addEventListener('hashchange', () => S && show());
      start();
    </script>
  </body>
</html>
