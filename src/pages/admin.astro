---
// Post admin. A static page with no secrets: signed-out visitors see the sign-in form, and every read or save goes to /api/admin/*,
// where server.js checks the session cookie. Plain on purpose: big text, big buttons, one thing per screen (volunteers use it).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | VFW Post 6493</title>
    <style is:global>
      @view-transition { navigation: auto; }
      @font-face { font-family: Archivo; src: url('/fonts/archivo.woff2') format('woff2'); font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; }
      @font-face { font-family: Literata; src: url('/fonts/literata.woff2') format('woff2'); font-weight: 200 900; font-display: swap; }
      :root { --night: #17120e; --on-dark: #f1eadf; --brass: #d6bb7e; --paper: #ece4d6; --card: #f7f2e9; --stone: #e0d6c4; --ink: #2a2119; --ink-2: #4f4236; --field: #5c4e40; --line: rgb(42 33 25 / .18);
        --gold-ink: #6a521d; --warn-bg: #f3e7c6; --red-ink: #7d2528; --bad-bg: #f4dedb; --olive: #4a5233; --ok-bg: #e4e6d3; --edit: #24405f; --edit-bg: #dfe6ee; --red: #952f32; --gold: #a58c52; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font: 19px/1.55 Archivo, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      h1, h2, .num { font-family: Literata, Georgia, serif; font-weight: 600; }
      h1 { font-size: 2rem; margin: 0 0 .5rem; line-height: 1.2; }
      h2 { font-size: 1.4rem; margin: 0 0 .75rem; line-height: 1.25; }
      a { color: var(--ink); }
      [hidden] { display: none !important; }
      :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
      .side :focus-visible, .top :focus-visible, .bar :focus-visible, .toast :focus-visible { outline-color: var(--brass); }
      .ic { display: inline-flex; flex: none; vertical-align: middle; }
      .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      .wrap { display: grid; grid-template-columns: 16rem minmax(0, 1fr); min-height: 100vh; }
      .top { display: none; }
      .side { background: var(--night); color: var(--on-dark); position: sticky; top: 0; height: 100vh; overflow: auto; display: flex; flex-direction: column; padding: 1.25rem .75rem; }
      .brand { padding: 0 .5rem 1.25rem; }
      .brand img { display: block; width: 152px; height: auto; }
      .brand p { margin: .35rem 0 0; font: 600 1.05rem Literata, Georgia, serif; color: var(--brass); }
      .brand::after { content: ''; display: block; width: 3rem; height: 2px; background: var(--gold); margin-top: .75rem; }
      .side nav, .tail { display: grid; gap: 2px; }
      .tail { margin-top: auto; padding-top: 1rem; }
      .side a, .side .linkbtn, .mnav a, .mnav .linkbtn { display: flex; align-items: center; gap: .7rem; min-height: 52px; padding: 0 .8rem; border-radius: 6px; font: 600 1.05rem/1.2 Archivo, system-ui, sans-serif; color: var(--on-dark); text-decoration: none; position: relative; width: 100%; background: none; border: 0; cursor: pointer; text-align: left; }
      .side a:hover, .side .linkbtn:hover, .mnav a:hover, .mnav .linkbtn:hover { background: rgb(241 234 223 / .08); }
      a[aria-current='page'] { background: rgb(214 187 126 / .16); color: var(--brass); }
      a[aria-current='page']::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 4px; background: var(--brass); border-radius: 2px; }
      .linkbtn { text-decoration: underline; }
      .count { margin-left: auto; background: var(--brass); color: var(--night); font-size: .85rem; font-weight: 700; border-radius: 999px; padding: 0 .55rem; }

      .main { padding: 1.5rem; max-width: 60rem; width: 100%; min-width: 0; }
      .banner { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; background: var(--bad-bg); color: var(--red-ink); font-weight: 700; border-radius: 6px; padding: .8rem 1rem; margin-bottom: 1.25rem; }
      .card { background: var(--card); border-radius: 6px; padding: 1.25rem; margin: 0 0 1.25rem; box-shadow: 0 1px 2px rgb(42 33 25 / .12); }
      .head { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
      .head h1 { margin: 0; }
      .meta, .hint { color: var(--ink-2); font-size: .95rem; }
      .big { font-size: 1.15rem; font-weight: 700; margin: 0 0 .25rem; }

      .fld { margin: 0 0 1.1rem; }
      .fld > label { display: block; font-weight: 600; }
      .opt { font-size: .85rem; font-weight: 500; color: var(--ink-2); margin-left: .5rem; }
      .hint { display: block; }
      input[type=text], input[type=password], input[type=date], input[type=time], input[type=number], input[type=email], input[type=url], select, textarea {
        display: block; width: 100%; min-height: 52px; margin-top: .3rem; padding: .55rem .7rem; font: inherit; color: inherit; background: var(--card); border: 2px solid var(--field); border-radius: 6px; }
      textarea { min-height: 8rem; }
      .fld.bad input, .fld.bad select, .fld.bad textarea { border-color: var(--red-ink); }
      .ferr, .err { color: var(--red-ink); font-weight: 700; margin: .3rem 0 0; }
      label.check { display: flex; gap: .75rem; align-items: center; font-weight: 600; min-height: 44px; margin: 0 0 .5rem; }
      input[type=color] { display: block; width: 100%; min-height: 52px; margin-top: .3rem; padding: .25rem; background: var(--card); border: 2px solid var(--field); border-radius: 6px; cursor: pointer; }
      input[type=checkbox] { width: 28px; height: 28px; flex: none; accent-color: var(--night); }
      .ff { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
      .ff .wide { grid-column: 1 / -1; }

      .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; font: inherit; font-weight: 700; min-height: 48px; padding: .5rem 1.1rem; border-radius: 6px; border: 2px solid var(--night); background: var(--night); color: var(--on-dark); cursor: pointer; text-decoration: none; }
      .btn.alt { background: var(--card); color: var(--ink); border-color: var(--ink); }
      .btn.danger { background: var(--card); color: var(--red-ink); border-color: var(--red-ink); }
      .btn.del { background: none; border-color: transparent; color: var(--red-ink); text-decoration: underline; font-weight: 600; font-size: .9rem; min-height: 44px; padding: .5rem .8rem; margin-left: auto; }
      .acts .btn.del { flex: 0 0 auto; }
      .btn.quiet { background: none; border-color: transparent; color: var(--ink); text-decoration: underline; }
      .row, .acts { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
      .chip { display: inline-block; font-size: .85rem; font-weight: 700; padding: .15rem .55rem; border-radius: 999px; background: var(--stone); color: var(--ink-2); line-height: 1.4; vertical-align: middle; }
      .chip.ok { background: var(--ok-bg); color: var(--olive); } .chip.warn { background: var(--warn-bg); color: var(--gold-ink); }
      .chip.bad { background: var(--bad-bg); color: var(--red-ink); } .chip.edit { background: var(--edit-bg); color: var(--edit); }

      .item { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; padding: .9rem 0; border-top: 1px solid var(--line); }
      .item:first-child, summary + .item { border-top: 0; }
      .item .what { flex: 1 1 18rem; min-width: 0; overflow-wrap: anywhere; }
      .item .t { display: flex; flex-wrap: wrap; gap: .25rem .6rem; align-items: center; font-size: 1.1rem; }
      .thumb { width: 96px; height: 72px; object-fit: cover; border-radius: 4px; flex: none; }
      .hl { animation: hl 1.5s ease-out; }
      @keyframes hl { from { background: var(--warn-bg); } to { background: transparent; } }
      .past summary, .msec summary { cursor: pointer; font-weight: 700; min-height: 44px; display: flex; align-items: center; gap: .6rem; }

      .seg { display: flex; flex-wrap: wrap; gap: .5rem; }
      .seg .btn[aria-pressed=true] { background: var(--night); color: var(--on-dark); border-color: var(--night); }
      .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
      .tile { margin: 0; padding: 1rem; color: var(--ink); text-decoration: none; display: block; }
      .tl { font-size: .95rem; font-weight: 600; color: var(--ink-2); }
      .num { font-size: 2.75rem; line-height: 1.15; }
      .chg { font-size: .95rem; display: flex; gap: .3rem; align-items: center; color: var(--ink-2); }
      .chg.up { color: var(--olive); }
      .chart { width: 100%; height: auto; display: block; }
      .chart text { font-size: 13px; fill: var(--ink-2); }
      .chart .gl { stroke: var(--line); }
      .chart .bar { fill: var(--gold-ink); } .chart .bar.hi { fill: var(--ink); }
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
      ul.rank { list-style: none; margin: 0; padding: 0; }
      ul.rank li { position: relative; display: flex; justify-content: space-between; gap: 1rem; align-items: center; min-height: 44px; padding: 0 .5rem; }
      ul.rank .bg { position: absolute; left: 0; top: 4px; bottom: 4px; background: rgb(165 140 82 / .18); border-radius: 4px; }
      ul.rank .nm, ul.rank .ct { position: relative; } ul.rank .ct { font-variant-numeric: tabular-nums; font-weight: 700; }

      .ev { display: flex; gap: .85rem; align-items: flex-start; min-height: 56px; padding: .6rem 0; border-top: 1px solid var(--line); }
      .ev:first-of-type { border-top: 0; }
      .evi { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--stone); color: var(--ink-2); }
      .evi.ok { background: var(--ok-bg); color: var(--olive); } .evi.warn { background: var(--warn-bg); color: var(--gold-ink); }
      .evi.bad { background: var(--bad-bg); color: var(--red-ink); } .evi.edit { background: var(--edit-bg); color: var(--edit); }
      .ev details summary { cursor: pointer; font-size: .95rem; color: var(--ink-2); min-height: 44px; display: inline-flex; align-items: center; padding: 0 .5rem; }

      .gate { max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
      .gate img { display: block; width: 200px; height: auto; margin: 0 0 1rem; }
      .pimg { width: 240px; height: 180px; object-fit: cover; border-radius: 6px; display: block; margin-bottom: .6rem; }
      .pimg.none { display: grid; place-items: center; border: 2px dashed var(--field); color: var(--ink-2); font-weight: 600; }
      .picker { margin-top: 1rem; padding: 1rem; background: var(--stone); border-radius: 6px; }
      .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: .6rem; max-height: 24rem; overflow: auto; padding: 4px; margin-bottom: 1rem; }
      label.pick { position: relative; display: block; margin: 0; aspect-ratio: 4 / 3; border-radius: 6px; background: var(--card); cursor: pointer; overflow: hidden; }
      label.pick img { width: 100%; height: 100%; object-fit: cover; display: block; }
      label.pick.up { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .3rem; border: 2px dashed var(--field); font-weight: 700; text-align: center; }
      label.pick:has(input:checked) { outline: 3px solid var(--ink); outline-offset: -3px; }
      label.pick:has(input:focus-visible) { outline: 3px solid var(--ink); outline-offset: 2px; }
      label.pick .chosen { display: none; position: absolute; right: 6px; top: 6px; gap: .25rem; align-items: center; background: var(--ink); color: var(--on-dark); border-radius: 999px; padding: 0 .55rem; font-size: .85rem; font-weight: 700; }
      label.pick:has(input:checked) .chosen { display: flex; }
      .preview img { width: 100%; height: auto; border-radius: 6px; display: block; margin-bottom: .75rem; }

      .menu-section { padding: 0; overflow: hidden; }
      .menu-section > summary { list-style: none; background: var(--stone); padding: .8rem 1.25rem; min-height: 56px; cursor: pointer; display: flex; align-items: center; gap: .75rem; }
      .menu-section > summary::-webkit-details-marker { display: none; }
      .menu-section .sname { font: 600 1.25rem Literata, Georgia, serif; }
      .menu-section .ic:last-child { margin-left: auto; }
      .menu-section[open] > summary .ic:last-child { transform: rotate(180deg); }
      .sbody { padding: 1.25rem; }
      .mitem { border: 1px solid var(--line); border-radius: 6px; padding: .9rem; margin: 0 0 .75rem; display: grid; gap: .75rem; }
      .mitem .fld { margin: 0; }
      .mline { display: grid; grid-template-columns: 1fr 9rem; gap: .75rem; }
      .mtools { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; }
      .mitem.off input[type=text] { opacity: .6; }
      .bar { position: sticky; bottom: 0; z-index: 6; background: var(--night); color: var(--on-dark); padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom)); border-radius: 6px; display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; }
      .bar .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brass); display: inline-block; margin-right: .5rem; }
      .bar .btn { background: var(--brass); color: var(--night); border-color: var(--brass); }
      .bar .btn.quiet { background: none; color: var(--on-dark); border-color: transparent; }
      .formbar { display: flex; flex-wrap: wrap; gap: .6rem; align-items: center; margin-top: .5rem; }

      .toast { position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%); background: var(--night); color: var(--on-dark); padding: .5rem .5rem .5rem 1.25rem; border-radius: 6px; z-index: 20; display: flex; gap: .75rem; align-items: center; min-height: 48px; max-width: calc(100vw - 2rem); }
      .toast button { background: none; border: 0; color: var(--brass); font: inherit; font-weight: 700; min-height: 48px; padding: 0 .75rem; cursor: pointer; text-decoration: underline; }
      body.has-bar .toast { bottom: 5.5rem; }
      dialog.ask { border: 0; border-radius: 6px; padding: 1.5rem; max-width: 28rem; width: calc(100vw - 2rem); background: var(--card); color: var(--ink); }
      dialog.ask::backdrop { background: rgb(23 18 14 / .6); }

      .btn.mv { white-space: nowrap; flex: 0 0 10.5rem; }
      .mv-gap { flex: 0 0 10.5rem; }
      .thumb-ph { object-fit: contain; padding: .5rem; background: var(--stone); }
      .mtools .btn.danger { margin-left: auto; }
      .who { flex: 1 1 100%; background: var(--stone); border-radius: 6px; padding: .5rem .9rem; }
      .who .p { display: flex; flex-wrap: wrap; gap: .25rem 1rem; align-items: center; padding: .6rem 0; border-top: 1px solid var(--line); }
      .who .p:first-child { border-top: 0; }
      .who .p > div { flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }
      .who a.tap { display: inline-flex; align-items: center; min-height: 48px; margin-right: 1rem; font-weight: 600; }
      .hb-nav { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin-bottom: .75rem; }
      .hb-nav h2 { margin: 0; text-align: center; }
      .hb-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
      .hb-wd { text-align: center; font-weight: 700; font-size: .85rem; color: var(--ink-2); }
      .hb-day { display: grid; place-items: center; align-content: center; gap: 1px; min-height: 58px; padding: 2px 0; font: inherit; color: var(--ink); background: var(--card); border: 2px solid var(--field); border-radius: 6px; cursor: pointer; }
      .hb-day b { font-size: 1.1rem; line-height: 1.1; }
      .hb-day small { font-size: .7rem; font-weight: 700; line-height: 1.1; }
      .hb-day.booked { background: var(--bad-bg); color: var(--red-ink); border-color: var(--red); }
      .hb-day.hold { background: var(--warn-bg); color: #5a4515; border-color: var(--gold-ink); }
      .hb-day.sel { outline: 3px solid var(--ink); outline-offset: 1px; }
      .hb-day:disabled { opacity: .45; cursor: default; background: none; border-color: var(--line); }
      .hb-gap { min-height: 58px; }
      .hb-row { width: 100%; justify-content: flex-start; text-align: left; margin-bottom: .5rem; flex-wrap: wrap; }
      @media (max-width: 480px) { .hb-day small { font-size: .6rem; } .hb-nav .btn { padding: .5rem .7rem; } .hb-nav h2 { font-size: 1.15rem; } }
      .priv { white-space: pre-wrap; background: var(--stone); border-radius: 6px; padding: .75rem 1rem; }
      @media (max-width: 800px) {
        .wrap { grid-template-columns: minmax(0, 1fr); }
        .side { display: none; }
        .top { display: flex; position: sticky; top: 0; z-index: 10; height: 64px; background: var(--night); align-items: center; justify-content: space-between; padding: 0 1rem; }
        .top img { height: 40px; width: auto; display: block; }
        .mnav summary { list-style: none; display: flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1rem; color: var(--on-dark); font-weight: 700; border: 2px solid var(--brass); border-radius: 6px; cursor: pointer; }
        .mnav summary::-webkit-details-marker { display: none; }
        .mnav > div { position: absolute; left: 0; right: 0; top: 64px; background: var(--night); padding: .5rem 1rem 1rem; max-height: calc(100vh - 64px); overflow: auto; }
        .mnav a, .mnav .linkbtn { min-height: 56px; }
        .main { padding: 1rem; }
        .btn { min-height: 52px; }
        .head .btn.add, .formbar .btn:not(.quiet), .sbody > .btn { width: 100%; }
        .acts { width: 100%; } .acts .btn { flex: 1; } .btn.del { min-height: 48px; }
        .tiles, .two, .ff, .mline { grid-template-columns: 1fr 1fr; }
        .two, .mline { grid-template-columns: 1fr; }
        .ff { grid-template-columns: 1fr 1fr; }
        .num { font-size: 2.2rem; }
        .formbar { position: sticky; bottom: 0; background: var(--card); padding: .6rem 0 calc(.6rem + env(safe-area-inset-bottom)); }
        .toast { bottom: 1rem; }
        .seg { display: grid; grid-template-columns: 1fr 1fr; }
        .mitem { padding: .7rem; gap: .5rem; } .mitem .mline { gap: .5rem; }
        .mtools label.check { flex-basis: 100%; } .mtools .btn { flex: 1 1 6rem; } .mv-gap { display: none; } .acts .whobtn { flex: 1 1 100%; }
      }
      @media (max-width: 480px) { .ff .fld.dt { grid-column: 1 / -1; } }
      @media (prefers-reduced-motion: reduce) { .hl { animation: none; } }
    </style>
  </head>
  <body>
    <div class="gate" id="gate" hidden>
      <form class="card" id="login" novalidate>
        <img src="/brand/logo.svg" width="200" height="103" alt="VFW Post 6493" />
        <h1>Website admin</h1>
        <p class="meta">Sign in to update the post's website.</p>
        <div class="fld"><label for="lu">Username</label><input id="lu" type="text" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required /></div>
        <div class="fld"><label for="lp">Password</label><input id="lp" type="password" name="password" autocomplete="current-password" required /></div>
        <p class="err" id="login-err" role="alert" hidden></p>
        <button class="btn" type="submit">Sign in</button>
      </form>
      <p><a href="/">Back to the website</a></p>
    </div>

    <div class="wrap" id="app" hidden>
      <header class="top">
        <a href="#dashboard"><img src="/brand/logo-mark-reverse.svg" width="152" height="60" alt="VFW Post 6493" /></a>
        <details class="mnav" id="mnav">
          <summary><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>Menu</summary>
          <div id="mlinks"></div>
        </details>
      </header>
      <aside class="side">
        <div class="brand"><a href="#dashboard"><img src="/brand/logo-mark-reverse.svg" width="152" height="60" alt="VFW Post 6493" /></a><p>Website admin</p></div>
        <nav id="links" aria-label="Admin sections"></nav>
        <div class="tail" id="tail"></div>
      </aside>
      <main class="main" id="main" tabindex="-1">
        <div class="banner" id="default-warning" hidden><span>The password is still the starter password. Please change it now.</span><a class="btn" href="#account">Change the password</a></div>
        <section data-section="dashboard"></section>
        <section data-section="events" hidden></section>
        <section data-section="specials" hidden></section>
        <section data-section="taps" hidden></section>
        <section data-section="honor" hidden></section>
        <section data-section="menu" hidden></section>
        <section data-section="news" hidden></section>
        <section data-section="shop" hidden></section>
        <section data-section="shop-orders" hidden></section>
        <section data-section="volunteers" hidden></section>
        <section data-section="inquiries" hidden></section>
        <section data-section="hall" hidden></section>
        <section data-section="help" hidden></section>
        <section data-section="security" hidden></section>
        <section data-section="settings" hidden></section>
        <section data-section="account" hidden></section>
      </main>
    </div>
    <div class="toast" id="toast" role="status" hidden></div>

    <script is:inline>
      const $ = (s, r = document) => r.querySelector(s);
      const h = (tag, props, ...kids) => {
        const el = document.createElement(tag);
        for (const [k, v] of Object.entries(props || {})) {
          if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
          else if (k === 'value' || k === 'checked') el[k] = v;
          else if (v !== false && v != null) el.setAttribute(k, v === true ? '' : v);
        }
        for (const kid of kids.flat()) if (kid != null && kid !== false) el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
        return el;
      };
      // replaceChildren() does not flatten arrays (they print as "[object HTMLDivElement]"), so every redraw goes through put().
      const put = (el, ...kids) => el.replaceChildren(...kids.flat(9).filter((k) => k != null && k !== false));
