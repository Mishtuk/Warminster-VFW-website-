        const all = secEvents.map((e) => ({ e, ...evInfo(e) })).filter((x) => secFilter === 'all' || (secFilter === 'in' ? /^(login|logout|lockout|password)/.test(x.e.type) : secFilter === 'edit' ? x.kind === 'edit' : ['warn', 'bad'].includes(x.kind))), rows = all.slice(0, secShown);
        const days = [], now = Date.now();
        for (const x of rows) { const day = etDay(x.e.at); if (days.at(-1)?.day !== day) days.push({ day, rows: [] }); days.at(-1).rows.push(x); }
        const dayName = (day) => (day === etDay(now) ? 'Today' : day === etDay(now - 864e5) ? 'Yesterday' : UTC(day, { weekday: 'long', month: 'long', day: 'numeric' }));
        put(sec, h('h1', {}, 'Security log'), h('p', {}, 'Sign-ins, lockouts, password changes and every change made in this admin. Kept automatically; nothing here can be edited.'),
          h('div', { class: 'seg', role: 'group', 'aria-label': 'Show', style: 'margin-bottom:1.25rem' }, FILTERS.map(([k, t]) => h('button', { class: 'btn alt', type: 'button', 'aria-pressed': String(k === secFilter), onclick: () => { secFilter = k; secShown = 50; drawSecurity(); } }, t))),
          days.length ? [days.map(({ day, rows: rs }) => [h('h2', {}, dayName(day)), h('div', { class: 'card' }, rs.map((x) => h('div', { class: 'ev' }, h('span', { class: 'evi ' + x.kind }, ico(x.icon)),
            h('div', {}, h('div', {}, h('strong', {}, x.name), x.detail && ' · ' + x.detail), h('div', { class: 'meta' }, new Date(x.e.at).toLocaleTimeString('en-US', { ...ET, hour: 'numeric', minute: '2-digit' }) + (x.who ? ' · ' + x.who : '')),
              x.ip && h('details', {}, h('summary', {}, 'More'), h('div', { class: 'meta' }, x.ip === 'This computer' ? 'This computer' : 'Internet address: ' + x.ip))))))]),
            all.length > secShown && h('button', { class: 'btn alt', type: 'button', onclick: () => { secShown += 50; drawSecurity(); } }, 'Show older entries')]
            : h('div', { class: 'card' }, h('p', { class: 'big' }, secEvents.length ? (secFilter === 'warn' ? 'No warnings in the log. All quiet.' : 'Nothing of that kind in the log.') : 'Nothing logged yet.')));
      }

      // ---------- account ----------
      function renderAccount() {
        guard = null;
        const sec = $('[data-section=account]');
        const err = h('p', { class: 'err', role: 'alert', hidden: true });
        const pw = (id, label, name, auto, x) => fld(id, label, h('input', { type: 'password', name, autocomplete: auto }), x);
        const form = h('form', { class: 'card', novalidate: true }, h('h2', {}, 'Change the password'),
          pw('pw-c', 'Current password', 'current', 'current-password'), pw('pw-n', 'New password', 'password', 'new-password', { hint: 'At least 10 characters. A short sentence is easy to remember.' }), pw('pw-a', 'New password again', 'again', 'new-password'),
          err, h('button', { class: 'btn', type: 'submit' }, 'Change password'));
        form.addEventListener('submit', async (e) => {
          e.preventDefault(); err.hidden = true;
          if (form.password.value !== form.again.value) { err.textContent = 'The two new passwords are not the same.'; err.hidden = false; return; }
          const r = await api('POST', 'admin/password', { current: form.current.value, password: form.password.value });
          if (!r.ok) { err.textContent = say(r); err.hidden = false; return; }
          form.reset(); $('#default-warning').hidden = true; toast('Password changed.');
        });
        put(sec, h('h1', {}, 'Account'), h('p', {}, 'Signed in as ' + S.user + '.'), form);
      }

      // ---------- hall bookings ----------
      let hallMonth = '', hallSel = '';
      const HALL_ERR = { past: 'That date has already gone by.', date: 'Pick a date within the next year.', status: 'Pick Booked or On hold.' };
      const HALL_WORD = { booked: 'Booked', hold: 'On hold' };
      /** Sets a date to booked or on hold, or opens it again when status is null. Returns true when it worked. */
      async function setHall(date, status, note = '') {
        const r = status ? await api('PUT', 'admin/hall-bookings/' + date, { status, note }) : await api('DELETE', 'admin/hall-bookings/' + date);
        if (!r.ok) toast(HALL_ERR[r.data.error] || say(r));
        return r.ok;
      }
      async function markHallBooked(q) {
        if (!(await setHall(q.event_date, 'booked', ('From inquiry: ' + q.name).slice(0, 120)))) return;
        hallSel = q.event_date; hallMonth = q.event_date.slice(0, 7);
        toast(short(q.event_date) + ' is now marked booked.', { label: 'See the calendar', fn: () => (location.hash = 'hall') });
      }
      async function renderHall() {
        guard = null;
        const sec = $('[data-section=hall]');
        const r = await api('GET', 'admin/hall-bookings');
        if (!r.ok) return put(sec, h('h1', {}, 'Hall bookings'), h('div', { class: 'card' }, h('p', { class: 'big' }, say(r))));
        const today = r.data.today, B = new Map(r.data.bookings.map((b) => [b.date, b]));
        const cur = today.slice(0, 7), lastDay = new Date(Date.parse(today + 'T12:00:00Z') + 366 * 864e5).toISOString().slice(0, 10), last = lastDay.slice(0, 7);
        if (!hallMonth || hallMonth < cur || hallMonth > last) hallMonth = cur;
        const step = (n) => { hallMonth = new Date(Date.UTC(+hallMonth.slice(0, 4), +hallMonth.slice(5) - 1 + n, 1)).toISOString().slice(0, 7); draw(); };
        async function change(date, status, note) { // updates the one date and redraws without asking the server again
          if (!(await setHall(date, status, note))) return;
          if (status) B.set(date, { date, status, note }); else B.delete(date);
          draw();
        }
        function draw() {
          const y = +hallMonth.slice(0, 4), m = +hallMonth.slice(5) - 1, lead = new Date(Date.UTC(y, m, 1)).getUTCDay(), n = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
          const cells = [...Array(lead).fill(null).map(() => h('span', { class: 'hb-gap', 'aria-hidden': 'true' })), ...Array.from({ length: n }, (_, i) => {
            const date = `${hallMonth}-${String(i + 1).padStart(2, '0')}`, b = B.get(date), st = b?.status ?? '';
            return h('button', { type: 'button', class: `hb-day ${st}${date === hallSel ? ' sel' : ''}`, disabled: date < today || date > lastDay, 'aria-label': `${short(date)}, ${HALL_WORD[st] ?? 'Open'}. Tap to change.`,
              onclick: () => { hallSel = date; change(date, st === '' ? 'booked' : st === 'booked' ? 'hold' : null, b?.note ?? ''); } }, h('b', {}, i + 1), h('small', {}, HALL_WORD[st] ?? 'Open'));
          })];
          const sel = B.get(hallSel), note = h('input', { type: 'text', maxlength: 120, value: sel?.note ?? '' });
          const upcoming = [...B.values()].sort((a, b) => (a.date < b.date ? -1 : 1));
          put(sec, h('h1', {}, 'Hall bookings'), h('p', {}, 'Tap a date to change it: Open, then Booked, then On hold, then Open again. Renters see these dates on the Rent the Hall page. They never see your notes.'),
            h('div', { class: 'card' },
              h('div', { class: 'hb-nav' }, h('button', { class: 'btn alt', type: 'button', disabled: hallMonth <= cur, onclick: () => step(-1) }, ico('back'), 'Previous'),
                h('h2', { 'aria-live': 'polite' }, UTC(hallMonth + '-01', { month: 'long', year: 'numeric' })),
                h('button', { class: 'btn alt', type: 'button', disabled: hallMonth >= last, onclick: () => step(1) }, 'Next')),
              h('div', { class: 'hb-grid' }, ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => h('div', { class: 'hb-wd' }, d)), cells)),
            hallSel && h('div', { class: 'card' }, h('h2', {}, short(hallSel), ' ', h('span', { class: sel ? (sel.status === 'booked' ? 'chip bad' : 'chip warn') : 'chip muted' }, sel ? HALL_WORD[sel.status] : 'Open')),
              sel ? [h('div', { class: 'fld wide' }, h('label', { for: 'hb-note' }, 'Note for the staff', h('span', { class: 'opt' }, 'Optional')), h('span', { class: 'hint', id: 'hb-note-h' }, 'Only staff see this. It never shows on the website.'), Object.assign(note, { id: 'hb-note' })),
                h('div', { class: 'row' }, h('button', { class: 'btn', type: 'button', onclick: async () => { if (await setHall(hallSel, sel.status, note.value)) { toast('Note saved.'); B.set(hallSel, { ...sel, note: note.value.trim() }); draw(); } } }, 'Save the note'),
                  h('button', { class: 'btn alt', type: 'button', onclick: () => change(hallSel, null) }, 'Mark this date open'))]
                : h('p', {}, 'This date is open. Tap it on the calendar to mark it booked, then you can add a note.')),
            h('h2', {}, 'Coming up'),
            upcoming.length ? upcoming.map((b) => h('button', { class: 'btn alt hb-row', type: 'button', onclick: () => { hallSel = b.date; hallMonth = b.date.slice(0, 7); draw(); } },
              h('strong', {}, short(b.date)), h('span', { class: b.status === 'booked' ? 'chip bad' : 'chip warn' }, HALL_WORD[b.status]), b.note && h('span', {}, b.note)))
              : h('div', { class: 'card' }, h('p', { class: 'big' }, 'Nothing is booked yet.'), h('p', {}, 'Every date shows as open to renters until you mark it.')));
        }
        draw();
      }

      // ---------- navigation ----------
      const VIEWS = { dashboard: renderDashboard, events: () => renderCrud('events'), specials: () => renderCrud('specials'), taps: () => renderCrud('taps'), honor: () => renderCrud('honor'), menu: renderMenu, news: () => renderCrud('news'), shop: () => renderCrud('products'), 'shop-orders': renderShopOrders, volunteers: renderVolunteers, inquiries: renderInquiries, hall: renderHall, help: renderHelp, security: renderSecurity, settings: renderSettings, account: renderAccount };
      let cur = '', restoring = false;
      function show() {
        const v = VIEWS[location.hash.slice(1)] ? location.hash.slice(1) : 'dashboard';
        cur = v; document.body.classList.remove('has-bar'); $('#mnav').open = false;
        document.querySelectorAll('[data-section]').forEach((s) => (s.hidden = s.dataset.section !== v));
        document.querySelectorAll('[data-view]').forEach((a) => (a.dataset.view === v.replace('-orders', '') ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current')));
        VIEWS[v]();
      }
      async function start() {
        const r = await api('GET', 'admin/state');
        if (!r.ok) return showLogin();
        S = r.data;
        const [ph, st] = await Promise.all([api('GET', 'admin/photos'), api('GET', 'admin/stats?range=7d')]);
        S.photos = ph.ok ? ph.data.photos : [];
        if (st.ok) setCount(st.data.inquiries.new);
        setCount(S.newHelp || 0, 'help'); setCount(S.newOrders || 0, 'shop');
        put($('#links'), navLinks()); put($('#tail'), navTail()); put($('#mlinks'), navLinks(), navTail());
        $('#gate').hidden = true; $('#app').hidden = false;
        $('#default-warning').hidden = !S.defaultPassword;
        show();
      }
      addEventListener('hashchange', async () => {
        if (!S) return;
        if (restoring) { restoring = false; return; }
        if (!(await leave())) { restoring = true; location.hash = cur; return; }
        show();
      });
      addEventListener('beforeunload', (e) => { if (guard?.()) e.preventDefault(); });
      start();
    </script>
  </body>
</html>
