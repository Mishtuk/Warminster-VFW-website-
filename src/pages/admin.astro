        if (!r.ok) return;
        secEvents = r.data.events; secShown = 50; drawSecurity();
      }
      function drawSecurity() {
        const sec = $('[data-section=security]');
        const all = secEvents.map((e) => ({ e, ...evInfo(e) })).filter((x) => secFilter === 'all' || (secFilter === 'in' ? /^(login|logout|lockout|password)/.test(x.e.type) : secFilter === 'edit' ? x.kind === 'edit' : ['warn', 'bad'].includes(x.kind))), rows = all.slice(0, secShown);
