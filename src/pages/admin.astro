        const sr = await api('GET', 'admin/security');
        if (sr.ok) {
          const n = sr.data.events.filter((e) => e.at > Date.now() - 7 * 864e5 && ['warn', 'bad'].includes(evInfo(e).kind)).length;
          put(secCard, h('h2', {}, 'Security'), h('p', {}, n ? h('span', { class: 'chip warn' }, `${plural(n, 'warning', 'warnings')} in the last 7 days`) : h('span', { class: 'chip ok' }, 'All quiet in the last 7 days')),
