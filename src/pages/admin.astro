        }
      }

      // ---------- security log ----------
      const EVT = { login_ok: ['Signed in', 'ok'], logout: ['Signed out', 'muted', 'door'], login_fail: ['Wrong username or password', 'warn'], lockout: ['Locked out after too many wrong tries', 'bad'],
        login_blocked: ['Sign-in refused while locked out', 'bad'], password_change: ['Password changed', 'ok'], password_change_fail: ['Password change refused: current password was wrong', 'warn'],
        password_change_blocked: ['Password changes paused: too many tries', 'bad'], menu_update: ['Saved the food menu', 'edit'], photo_upload: ['Uploaded a picture', 'edit'], photo_delete: ['Deleted a picture', 'edit', 'bin'],
        photo_upload_blocked: ['Stopped a picture upload that was not allowed', 'warn'], inquiry_delete: ['Deleted a hall inquiry', 'edit', 'bin'], inquiries_purged: ['Old hall inquiries cleared automatically', 'muted', 'clock'],
        inquiry_honeypot: ['Stopped a spam message on the hall form', 'warn'], inquiry_rate_limited: ['Too many hall messages from one visitor', 'warn'] };
      for (const [k, t] of [['events', 'an event'], ['specials', 'a drink special'], ['news', 'a news item']]) for (const [a, w] of [['create', 'Added'], ['update', 'Changed'], ['delete', 'Deleted']]) EVT[`${k}_${a}`] = [`${w} ${t}`, 'edit', a === 'delete' ? 'bin' : 'pencil'];
      const KIND_ICON = { ok: 'check', warn: 'warn', bad: 'bshield', edit: 'pencil', muted: 'clock' };
      function evInfo(e) {
        let [name, kind, icon] = EVT[e.type] || ['Other activity', 'muted'], detail = e.detail;
        if (e.type === 'inquiry_update') { name = / · handled$/.test(detail) ? 'Marked a hall inquiry as handled' : 'Marked a hall inquiry as new'; detail = detail.replace(/ · (handled|new)$/, ''); kind = 'edit'; }
        if (kind !== 'edit' || /^id \S+/.test(detail) || e.type === 'photo_upload' || e.type === 'photo_delete') detail = '';
        const local = ['::1', '127.0.0.1', '::ffff:127.0.0.1'].includes(e.ip);
