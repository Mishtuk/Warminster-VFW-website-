        put(sec, h('h1', {}, 'Hall inquiries'), h('p', {}, 'Messages from the hall rental form. They are also emailed to the post.'),
          list.length ? list.map((q) => h('div', { class: 'card' },
            h('h2', {}, q.name, ' ', h('span', { class: q.handled ? 'chip muted' : 'chip warn' }, q.handled ? 'Handled' : 'New')),
            h('p', { class: 'meta' }, 'Received ' + when(q.at) + (q.emailed ? '' : ' · the email to the post did not go out')),
            h('p', {}, q.phone && h('span', {}, 'Phone: ', h('a', { href: 'tel:' + q.phone.replace(/[^\d+]/g, '') }, q.phone), h('br')), q.email && h('span', {}, 'Email: ', h('a', { href: 'mailto:' + q.email }, q.email), h('br')),
