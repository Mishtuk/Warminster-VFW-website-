---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { POST, href, photo } from '../lib/site';
import { HALL_PHOTOS } from '../lib/hall-photos';
const gallery = JSON.stringify(HALL_PHOTOS.map((p) => ({ src: photo(p.name).src, alt: p.alt, cap: p.cap })));
---
<Base title="Rent the Hall" description={POST.hallBlurb}>
  <PageHead title="Rent the Hall" lede="Our hall is always available for rent." image="hall-07" />

  <section class="section">
    <div class="container">
      <div class="section-head"><h2 class="bars">What's included</h2></div>
      <ul class="facts">
        {POST.hallFacts.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container"><div class="panel">
      <div class="section-head"><h2 class="bars">Planning your event</h2></div>
      <div class="faq">
        <details><summary>Can I bring my own food, DJ or band?</summary><p>Yes. You can supply your own food and entertainment. Food is renter supplied and staff is not included.</p></details>
        <details><summary>Is there a bar?</summary><p>Yes. We have complete bar facilities, with full-service alcohol.</p></details>
        <details><summary>What comes with the hall?</summary><p>Free wifi, and tables and chairs are furnished. Setup and cleaning are venue assisted. There is a stage, shown in the photos below.</p></details>
        <details><summary>Is the kitchen open on rental days?</summary><p>No. The kitchen is closed on rental days, so plan to bring your food.</p></details>
        <details><summary>Can I see the hall first?</summary><p>Yes. Tours are by phone appointment. Call <a href={POST.tel}>{POST.phone}</a>.</p></details>
        <details><summary>Is there a discount for non-profits?</summary><p>Yes. The post offers discounted rates for non-profit events.</p></details>
        <details><summary>What does it cost? How many people fit? Is there a deposit? Parking?</summary><p>Call the post at <a href={POST.tel}>{POST.phone}</a> for price, capacity, deposit, hours and parking.</p></details>
      </div>
      <h3 style="margin-top:2rem">Events held in the hall</h3>
      <p>Banquets, craft fairs, fundraisers, trivia nights, dinners and parties, including the Delta Waterfowl banquet, Cub Scout Pack 139's craft fair, the Auxiliary Cash Bash and the post's 60th anniversary dinner.</p>
    </div></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2 class="bars">Photos of the hall</h2></div>
      <ul class="gallery" data-gallery="hall">
        {HALL_PHOTOS.map((p) => (
          <li><a href={photo(p.name).src}><img {...photo(p.name)} sizes="(min-width: 800px) 33vw, 100vw" alt={p.alt} loading="lazy" decoding="async" fetchpriority="low" /></a></li>
        ))}
      </ul>
      <script type="application/json" data-gallery-list="hall" set:html={gallery}></script>
    </div>
  </section>

  <section class="section band-stone" id="inquiry">
    <div class="container split-wide" style="align-items:start">
      <div class="panel">
        <h2 class="bars">Ask about renting the hall</h2>
        <div id="form-status" class="form-status" role="status" hidden style="margin-top:1.5rem"></div>
        <form class="form" id="hall-form" method="post" action={href('/api/hall-inquiry')} style="margin-top:1.5rem" novalidate>
          <input type="hidden" name="_page" value="/hall" />
          <div class="form-row">
            <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" /></div>
            <div class="field"><label for="f-phone">Phone <span class="opt">(optional)</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" aria-describedby="f-contact" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="f-email">Email <span class="opt">(optional)</span></label><input id="f-email" name="email" type="email" autocomplete="email" maxlength="200" aria-describedby="f-contact" /></div>
            <div class="field"><label for="f-date">Event date <span class="opt">(optional)</span></label><input id="f-date" name="eventDate" type="date" /></div>
          </div>
          <p class="hint" id="f-contact">Phone or email, so we can reach you.</p>
          <div class="field">
            <label for="f-type">Type of event <span class="opt">(optional)</span></label>
            <select id="f-type" name="eventType">
              <option value="">Choose one</option>
              <option>Birthday</option><option>Anniversary</option><option>Wedding or shower</option><option>Memorial / repast</option><option>Meeting</option><option>Other</option>
            </select>
          </div>
          <div class="field"><label for="f-guests">Approximate guests <span class="opt">(optional)</span></label><input id="f-guests" name="guests" type="number" inputmode="numeric" min="1" max="1000" /></div>
          <div class="field"><label for="f-msg">Message <span class="opt">(optional)</span></label><textarea id="f-msg" name="message" maxlength="2000"></textarea></div>
          <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
          <p><button class="btn" type="submit">Send inquiry</button></p>
          <p class="hint">We use what you send only to answer your hall rental question. Inquiries are kept for up to 12 months and then deleted; call the post any time to have yours removed.</p>
        </form>
      </div>
      <aside class="menu-card" aria-labelledby="hall-ask">
        <h2 id="hall-ask">Ask about your date</h2>
        <p class="menu-note"><a href={POST.tel} style="font-family:var(--font-display);font-weight:700;font-size:var(--step-3)">{POST.phone}</a></p>
        <p>Hall rental email: <a href={POST.hallMail}>{POST.hallEmail}</a></p>
        <p>Post email: <a href={POST.mail}>{POST.email}</a></p>
        <p>{POST.address}. We'll call you back to confirm dates and details.</p>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ phone: POST.phone }}>
    (() => {
      const form = document.getElementById('hall-form');
      const box = document.getElementById('form-status');
      const msgs = {
        name: 'Please enter your name.',
        phone: 'That phone number does not look right.',
        email: 'That email address does not look right.',
        contact: 'Please give a phone number or an email so we can reach you.',
        eventDate: 'That event date does not look right.',
        guests: 'Please enter the number of guests as a number.',
        rate: 'Too many inquiries from this device. Please try again later or call the post.',
      };
      const show = (text, ok) => { box.hidden = false; box.className = 'form-status ' + (ok ? 'ok' : 'err'); box.textContent = text; box.scrollIntoView({ block: 'center' }); };
      const q = new URLSearchParams(location.search);
      if (q.get('sent') === '1') show("Thank you. We got your inquiry and will call you back to confirm.", true);
      else if (q.get('error')) show(msgs[q.get('error')] || 'Something went wrong. Please call the post at ' + phone + '.', false);
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          const out = await res.json();
          if (out.ok) { form.reset(); show('Thank you. We got your inquiry and will call you back to confirm.', true); }
          else show(msgs[out.error] || 'Something went wrong. Please call the post at ' + phone + '.', false);
        } catch {
          show('Please call the post at ' + phone, false);
        }
      });
    })();
  </script>
</Base>
