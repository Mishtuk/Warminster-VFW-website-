---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { POST } from '../lib/site';
import { seed } from '../lib/seed';
import { latestVeteranNews, FALLBACK_LINKS } from '../lib/feeds';
const items = await latestVeteranNews(8);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
---
<Base title="News" description={`News from ${POST.name} and the latest veteran news.`}>
  <PageHead title="News" lede="News from the post, and the latest news for veterans." />

  <section class="section band-paper">
    <div class="container news-layout">
      <div>
        <h2>From the post</h2>
        <div style="margin-top:1.5rem"><Fragment set:html={seed.news} /></div>
      </div>
      <aside>
        <h2>Veteran news</h2>
        {items.length ? (
          <ul class="link-list" style="margin-top:1rem">
            {items.map((i) => (
              <li><a href={i.link} rel="noopener"><span>{i.title}</span><small>{i.source}, {fmt(i.date)}</small></a></li>
            ))}
          </ul>
        ) : (
          <>
            <p style="margin-top:0.75rem">Where to find veteran news:</p>
            <ul class="link-list" style="margin-top:0.5rem">
              {FALLBACK_LINKS.map((l) => <li><a href={l.url} rel="noopener"><span>{l.title}</span><small>{l.note}</small></a></li>)}
            </ul>
          </>
        )}
      </aside>
    </div>
  </section>
  <Fragment set:html={seed.data} />
</Base>
