---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import InfoSection from '../components/info/InfoSection.astro';
import OnThisPage from '../components/info/OnThisPage.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { POST, href } from '../lib/site';
import { seed } from '../lib/seed';
import { newsHtml } from '../lib/state.js';
import news from '../content/news.json';
// Post news with photos: the same renderer the server uses, told which photo files exist (build runs from the repo root).
const photos = new Set(readdirSync(join(process.cwd(), 'public', 'media', 'photos')));
const postNews = `<!--vfw:news-->${newsHtml(news, { photos, photoBase: href('/media/photos/'), empty: 'No post news yet. Check back soon.' })}<!--/vfw:news-->`;
import { latestVeteranNews, FALLBACK_LINKS } from '../lib/feeds';
// image: optional self-hosted thumbnail from feeds.ts (VA, DVIDS).
const items = (await latestVeteranNews(8)) as (Awaited<ReturnType<typeof latestVeteranNews>>[number] & { image?: { src: string; alt?: string } })[];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' });
// Badge text when a story has no picture: "VA News", "VA Press Room" -> "VA"; others keep their name.
const badge = (source: string) => (/^VA\b/.test(source) ? 'VA' : source);
const sections = [
  { id: 'post-news', label: 'From the post' },
  ...(items.length ? [{ id: 'veteran-news', label: 'Veteran news' }] : []),
  { id: 'more-news', label: 'More news sources' },
];
---
<Base title="News" description={`News from ${POST.name} and the latest veteran news.`}>
  <PageHead title="News" lede="News from the post first, then the latest news for veterans from outside sources." />
  <OnThisPage items={sections} />

  <InfoSection id="post-news" title="From the post" summary="Announcements from Post 6493, newest first." panel>
    <Fragment set:html={postNews} />
  </InfoSection>

  {items.length > 0 && (
    <InfoSection id="veteran-news" title="Veteran news" summary="Recent headlines for veterans. Each card opens the full story on the source's site." band="stone">
      <ul class="feed-grid">
        {items.map((i) => (
          <li>
            <a class="feed-card" href={i.link} rel="noopener">
              {i.image?.src
                ? <img class="feed-thumb" src={i.image.src} alt={i.image.alt ?? ''} width="480" height="270" loading="lazy" decoding="async" />
                : <span class="feed-thumb feed-badge" aria-hidden="true">{badge(i.source)}</span>}
              <span class="feed-text">
                <span class="feed-title">{i.title}</span>
                <small>{i.source}, {fmt(i.date)}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </InfoSection>
  )}

  <InfoSection id="more-news" title="More news sources" summary="Where to read more veteran news and find resources." panel>
    <ul class="link-list more-grid">
      {FALLBACK_LINKS.map((l) => <li><a href={l.url} rel="noopener"><span>{l.title}</span><small>{l.note}</small></a></li>)}
    </ul>
  </InfoSection>
  <Fragment set:html={seed.data} />
</Base>

<style>
  /* Veteran news: horizontal cards, thumbnail (or source badge) left, headline right. */
  .feed-grid { list-style: none; padding: 0; display: grid; gap: clamp(0.9rem, 0.6rem + 1vw, 1.25rem); }
  @media (min-width: 900px) { .feed-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .feed-card {
    display: grid; grid-template-columns: clamp(6rem, 4rem + 8vw, 9.5rem) 1fr; gap: 1rem; align-items: start; height: 100%;
    padding: 0.75rem; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 4px; box-shadow: var(--shadow); text-decoration: none;
  }
  .feed-card:hover { border-color: var(--gold); }
  .feed-card:hover .feed-title { text-decoration: underline 2px var(--gold); text-underline-offset: 5px; }
  .feed-thumb { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 2px; background: var(--stone); }
  .feed-badge {
    display: grid; place-items: center; padding: 0.5rem; text-align: center;
    background: var(--night); color: var(--brass); box-shadow: inset 0 -4px 0 var(--gold);
    font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); line-height: 1.1;
  }
  .feed-text { display: grid; gap: 0.35rem; padding-top: 0.15rem; }
  .feed-title { font-weight: 700; line-height: 1.3; }
  .feed-text small { font-size: var(--step--1); color: var(--ink-2); }

  /* More sources: link rows in columns on desktop. */
  .more-grid { display: grid; column-gap: 2rem; }
  @media (min-width: 760px) { .more-grid { grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); } .more-grid li { border-top: 1px solid var(--line); } }

  /* Post news: photo left, story right on desktop. Items without a photo get a quiet post mark in the same slot. */
  :global(#post-news .vfw-news-photo) { margin: 0.75rem 0 0.25rem; background: var(--snap); padding: 6px; box-shadow: var(--shadow); max-width: 34rem; }
  :global(#post-news .vfw-news-photo img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 760px) {
    :global(#post-news .vfw-news-item) { display: grid; grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); column-gap: 2rem; align-content: start; }
    :global(#post-news .vfw-news-item > *) { grid-column: 2; }
    :global(#post-news .vfw-news-item > .vfw-news-photo) { grid-column: 1; grid-row: 1 / span 4; margin: 0.25rem 0 0; transform: rotate(-0.8deg); }
    :global(#post-news .vfw-news-item:not(:has(.vfw-news-photo))::before) {
      content: ''; grid-column: 1; grid-row: 1 / span 4; align-self: start; margin-top: 0.25rem; aspect-ratio: 4 / 3; border-radius: 2px;
      background: linear-gradient(90deg, var(--gold) 0 30%, transparent 30% 52%, var(--gold) 52% 100%) center / 2.25rem 3rem no-repeat, var(--night);
      box-shadow: inset 0 -4px 0 var(--gold);
    }
  }
  @media (prefers-reduced-motion: reduce) { :global(#post-news .vfw-news-photo) { transform: none !important; } }
</style>
