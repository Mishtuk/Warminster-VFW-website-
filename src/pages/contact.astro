---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Subnav from '../components/Subnav.astro';
import InfoSection from '../components/info/InfoSection.astro';
import KeyFacts from '../components/info/KeyFacts.astro';
import { POST, ABOUT_TABS, href, photo } from '../lib/site';
const tabs = ABOUT_TABS;
---
<Base title="Contact" description={`Address, phone and Facebook group for ${POST.name}.`}>
  <PageHead title="Contact" lede="Phone, address, email and opening hours for the post." />
  <Subnav items={tabs} label="About" />

  <InfoSection id="reach" title="Call or visit" summary={`${POST.address}.`}>
    <div class="info-two">
      <KeyFacts title="Reach the post" today email hallEmail facebook />
      <figure class="snap" style="--tilt:1.2deg">
        <img {...photo('hall-01')} sizes="(min-width: 900px) 35vw, 100vw" alt="The outside of the post building" loading="lazy" decoding="async" fetchpriority="low" />
        <figcaption>The post at {POST.street}</figcaption>
      </figure>
    </div>
  </InfoSection>

  <InfoSection id="getting-here" title="Getting here" summary={`${POST.address}.`} panel>
    <dl class="rows">
      {POST.gettingHere.map((r) => (
        <div><dt>{r.label}</dt><dd>{r.text}{r.text && ' '}<a href={POST.tel}>{r.ask}</a></dd></div>
      ))}
    </dl>
    <p><a class="btn btn-outline" href={POST.mapsUrl} rel="noopener">Directions</a></p>
  </InfoSection>

  <InfoSection id="hours" title="Hours" summary="The bar, the kitchen and the office keep different hours." band="stone">
    <div class="hours-grid">
      <div class="panel info-body">
        <h3>Bar</h3>
        <dl class="rows">{POST.hours.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}</dl>
      </div>
      <div class="panel info-body">
        <h3>Kitchen</h3>
        <dl class="rows">{POST.kitchen.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}</dl>
        <p class="hint">Call to confirm; the kitchen is closed on hall rental days.</p>
      </div>
      <div class="panel info-body">
        <h3>Office</h3>
        <dl class="rows"><div><dt>Open</dt><dd>{POST.officeHours}</dd></div></dl>
      </div>
    </div>
  </InfoSection>

  <InfoSection id="welcome" title="Who can come in" summary={POST.barRule} panel>
    <dl class="rows">
      <div><dt>Members and guests</dt><dd>The bar is for members and their guests, and joining is easy. <a href={href('/join')}>How to join</a></dd></div>
      <div><dt>Open to the public</dt><dd>Events marked Open to the Public need no membership: {POST.publicNights.join(', ')}.</dd></div>
      <div><dt>Renting the hall</dt><dd><a href={href('/hall#inquiry')}>Send a hall inquiry</a></dd></div>
    </dl>
  </InfoSection>
</Base>

<style>
  .hours-grid { display: grid; gap: clamp(1rem, 0.6rem + 1.5vw, 1.5rem); }
  @media (min-width: 900px) { .hours-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; } }
  .hours-grid .rows > div { grid-template-columns: 1fr auto; }
</style>
