---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { NAV, href } from '../lib/site';
---
<Base title="Page not found">
  <PageHead title="Page not found" lede="We could not find that page. Try one of these." />
  <section class="section band-paper">
    <div class="container">
      <ul class="chips">
        {NAV.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
