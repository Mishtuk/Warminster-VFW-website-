---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import InfoSection from '../components/info/InfoSection.astro';
import OnThisPage from '../components/info/OnThisPage.astro';
import { POST, photo, href } from '../lib/site';
import { seed, year } from '../lib/seed';
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].map((label, i) => ({ label, id: `month-${i + 1}` }));
const sections = [
  { id: 'upcoming', label: 'Coming up' },
  { id: 'regular', label: 'Every week' },
  { id: 'calendar', label: `Full ${year} calendar` },
  { id: 'add', label: 'Add to your calendar' },
];
---
<Base title="Events and calendar" description={`Upcoming events and the ${year} calendar at ${POST.name}.`}>
  <PageHead title="Events and calendar" lede={`What's coming up, the nights that repeat every week, and the full ${year} calendar.`} />
  <OnThisPage items={sections} />

  <InfoSection id="upcoming" title="Coming up" summary="The next events at the post.">
    <div class="info-two">
      <div class="panel"><Fragment set:html={seed.upcoming} /></div>
      <figure class="snap" style="--tilt:1.4deg">
        <img {...photo('life-linedance')} sizes="(min-width: 900px) 35vw, 100vw" alt="Line dancing at the post" loading="lazy" decoding="async" fetchpriority="low" />
        <figcaption>Line dancing at the post, 2026</figcaption>
      </figure>
    </div>
  </InfoSection>

  <InfoSection id="regular" title="Every week and every month" summary="These nights repeat. Their dates are marked on the calendar below.">
    <Fragment set:html={seed.regular} />
  </InfoSection>

  <InfoSection id="calendar" title={`Full ${year} calendar`} summary="Pick a month, or scroll through the year. Event days are dark, with a ribbon for the kind of event." band="stone">
    <OnThisPage items={months} title="" label="Jump to a month" />
    <div class="cal-key" aria-hidden="true"><span class="k-event">Event day</span><span class="k-today">Today</span><span class="k-cat vfw-cat-bar">Bar</span><span class="k-cat vfw-cat-post">Post</span><span class="k-cat vfw-cat-auxiliary">Auxiliary</span><span class="k-cat vfw-cat-community">Community</span><span class="k-cat vfw-cat-holiday">Holiday</span></div>
    <Fragment set:html={seed.calendar} />
  </InfoSection>

  <InfoSection id="add" title="Add to your calendar" summary="Put every post event in your phone or computer calendar, or print the year." class="no-print">
    <p class="btn-row"><a class="btn" href={href('/events.ics')} download>Add to my calendar</a><button class="btn btn-outline" type="button" id="print-cal">Print this calendar</button></p>
  </InfoSection>
  <Fragment set:html={seed.data} />
  <script>
    document.getElementById('print-cal')?.addEventListener('click', () => print());
  </script>
</Base>

<style>
  :global(#calendar .otp) { padding: 0 0 1.25rem; }
  :global(#calendar .otp .container) { width: 100%; }
  :global(#calendar .otp li) { flex: 0 0 auto; }
  :global(#calendar .otp a) { width: auto; min-width: 4.75rem; justify-content: center; }
  /* Regular nights: a row of cards, each with its day as a badge (markup from state.js regularHtml) */
  :global(#regular .vfw-regular) { display: grid; gap: clamp(1rem, 0.6rem + 1.5vw, 1.5rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  :global(#regular .vfw-regular > .vfw-event) {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem;
    padding: clamp(1.1rem, 1rem + 0.8vw, 1.5rem); border-top: 0; border-radius: 4px; background: var(--card); box-shadow: var(--shadow);
  }
  :global(#regular .vfw-regular .vfw-event-date) {
    order: -2; display: inline-block; padding: 0.3rem 0.75rem; border-radius: 3px; background: var(--night); color: var(--brass);
    box-shadow: inset 0 -3px 0 var(--gold); font-weight: 700; line-height: 1.3;
  }
  :global(#regular .vfw-regular .vfw-event-title) { order: -1; margin-top: 0.35rem; font-size: var(--step-1); }
  :global(#regular .vfw-regular .vfw-event-time) { font-weight: 650; color: var(--ink); }
  :global(#regular .vfw-regular .vfw-event-cat) { justify-self: auto; }
  :global(#regular .vfw-regular > .vfw-event > *) { max-width: 100%; }
  :global(#regular .vfw-regular .vfw-event-desc) { margin-top: 0.25rem; overflow-wrap: anywhere; }
  :global(.vfw-month) { scroll-margin-top: calc(var(--header-h) + 0.5rem); }
  @media print { :global(.otp) { display: none; } }
</style>
