---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Subnav from '../components/Subnav.astro';
import InfoSection from '../components/info/InfoSection.astro';
import OnThisPage from '../components/info/OnThisPage.astro';
import CrisisBox from '../components/CrisisBox.astro';
import { POST, href, PROGRAM_TABS } from '../lib/site';
import { BENEFITS } from '../lib/resources.js';
const sections = [{ id: 'request', label: 'Ask for help' }, { id: 'other', label: 'Other help' }];
const other = ['VFW free claims help', 'Bucks County Military and Veterans Affairs', 'VA.gov'].map((n) => BENEFITS.find((b) => b.name === n)!);
// Static seed = the off state ("Call the post"). The server swaps in the live form when the admin turns it on.
const seed = `<!--vfw:help-form--><div class="panel vfw-help-off"><h3>Call the post and ask for help for a veteran</h3>`
  + `<p>Call the post and tell them what you need. They can point you to free help like VFW Service Officers, who help with benefits and VA claims at no cost.</p>`
  + `<p class="btn-row"><a class="btn" href="${POST.tel}">Call ${POST.phone}</a><a class="btn btn-outline" href="${href('/resources')}">See the Resources page</a></p></div><!--/vfw:help-form-->`;
---
<Base title="Ask the post for help" description={`Veterans and families can ask ${POST.name} for a ride to a VA appointment, a visit, or help finding benefits.`}>
  <PageHead title="Ask the post for help" lede="For veterans and their families: a ride to a VA appointment, a visit, or help finding benefits." />
  <Subnav items={PROGRAM_TABS} label="Programs and resources" />
  <CrisisBox><p><strong>In an emergency, call 911.</strong></p></CrisisBox>
  <OnThisPage items={sections} />

  <InfoSection id="request" title="Ask for help" summary="Call the post for a ride, a visit or help with benefits." band="stone">
    <div id="help-status" class="form-status" role="status" data-phone={POST.phone} hidden></div>
    <Fragment set:html={seed} />
  </InfoSection>

  <InfoSection id="other" title="Other help" summary="Free help you can reach right now.">
    <div class="panel info-body">
      <ul class="link-list">
        {other.map((b) => <li><a href={b.url} rel="noopener"><span>{b.name}</span><small>{b.line}</small></a></li>)}
      </ul>
      <p class="btn-row"><a class="btn btn-outline" href={href('/resources')}>More on the Resources page</a></p>
    </div>
  </InfoSection>
</Base>

<style is:global>
  .vfw-help .panel h3 + .tl { margin-top: 1rem; }
  .vfw-help .panel .tl li { grid-template-columns: 1fr; }
  .vfw-help .panel .tl .what { padding-left: 0; border-left: 0; }
</style>

<script>
  // Help request form (made by the server in the help-form marker). With JS it posts JSON and replaces the form with the answer;
  // without JS the server redirects back with ?sent=1 or ?error=CODE.
  const box = document.getElementById('help-status')!;
  const phone = box.dataset.phone;
  const msgs: Record<string, string> = {
    name: 'Please enter your name.', phone: 'That phone number does not look right.', email: 'That email address does not look right.',
    contact: 'Please give a phone number or an email.', kind: 'Please pick what we can help with.', bestTime: 'Please pick one of the times, or leave it empty.',
    rate: 'Too many requests from this device. Please call the post.', off: 'The request form is not open right now. Please call the post at ' + phone + '.',
  };
  const show = (text: string, ok: boolean) => { box.hidden = false; box.className = 'form-status ' + (ok ? 'ok' : 'err'); box.textContent = text; box.scrollIntoView({ block: 'center' }); };
  const thanks = (who?: string) => `Thank you. Your request was sent${who ? ' to ' + who : ''}. They will call or email you back. If it becomes urgent, call 988 and press 1.`;
  const form = document.querySelector<HTMLFormElement>('form[action$="/api/help-request"]');
  const q = new URLSearchParams(location.search);
  if (q.get('sent') === '1') { show(thanks(), true); form?.replaceWith(box); }
  else if (q.get('error')) show(msgs[q.get('error')!] || 'Something went wrong. Please call the post at ' + phone + '.', false);
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form) as any)) });
      const out = await res.json();
      if (out.ok) { form.replaceWith(box); show(thanks(out.responder), true); }
      else show(msgs[out.error] || 'Something went wrong. Please call the post at ' + phone + '.', false);
    } catch {
      show('Please call the post at ' + phone, false);
    }
  });
</script>
