---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Subnav from '../components/Subnav.astro';
import Membership from '../components/Membership.astro';
import { POST, href } from '../lib/site';
const tabs = [{ label: 'About', path: '/about' }, { label: 'History', path: '/history' }, { label: 'Contact', path: '/contact' }];
---
<Base title="About the post" description={`About ${POST.name} in ${POST.city}, PA.`}>
  <PageHead title="About the post" lede={POST.motto} />
  <Subnav items={tabs} label="About" />

  <section class="section">
    <div class="container"><div class="panel prose">
      <h2 class="bars">Who we are</h2>
      <p>{POST.name} is a Veterans of Foreign Wars post and auxiliary in {POST.city}, Pennsylvania. Our Facebook group describes us with one line: "{POST.motto}."</p>
      <p>The post is at {POST.address}. Call us at <a href={POST.tel}>{POST.phone}</a>.</p>
      <p>The post has a bar, hosts events, and rents its hall for private parties. See <a href={href('/bar')}>The Bar</a>, <a href={href('/events')}>Events</a> and <a href={href('/hall')}>Hall Rental</a>. You can also read about the <a href={href('/history')}>history</a> of the VFW and the post, or find us on the <a href={POST.facebook} rel="noopener">Facebook group</a>.</p>
    </div></div>
  </section>

  <section class="section">
    <div class="container"><div class="panel prose">
      <h2 class="bars">Leaders</h2>
      <p>Post Commander: {POST.commander}. Auxiliary President: {POST.auxPresident}. Both took office in June 2026.</p>
      <h3>Past leaders</h3>
      <ol class="timeline">
        {POST.pastCommanders.map(([n, d]) => <li><span class="year">{n}</span>{d}</li>)}
        <li><span class="year">{POST.pastAuxPresident}</span>Auxiliary President until June 2026</li>
      </ol>
      <p>The post's official name is {POST.officialName}. {POST.joinPrice} {POST.barRule}</p>
    </div></div>
  </section>

  <Membership />

</Base>
