---
/**
 * Home opening: a full-width background video of the post (poster until the cut lands) under a warm,
 * candle-lit scrim. A plain greeting, today's bar hours, the motto and three ways in. On wide screens a
 * snapshot from the bar is pinned beside the greeting. Video <source>s are only written when the files exist.
 */
import fs from 'node:fs';
import path from 'node:path';
import { POST, href, photo } from '../lib/site';
import TodayHours from './TodayHours.astro';
import HeroCarousel from './HeroCarousel.astro';

const has = (f: string) => fs.existsSync(path.join(process.cwd(), 'public/media', f));
const sources = ['hero-portrait.mp4', 'hero-720.mp4', 'hero.av1.mp4', 'hero.mp4'].filter(has);
---

<section class="welcome" aria-labelledby="welcome-title">
  <div class="welcome-media" aria-hidden="true">
    <picture>
      <source media="(max-width: 700px) and (orientation: portrait)" srcset={`${href('/media/hero-poster-portrait-m.jpg')} 540w, ${href('/media/hero-poster-portrait.jpg')} 1080w`} sizes="100vw" />
      <img class="welcome-poster" src={href('/media/hero-poster.jpg')} srcset={`${href('/media/hero-poster-m.jpg')} 960w, ${href('/media/hero-poster.jpg')} 1920w`} sizes="100vw" alt="" width="1024" height="576" fetchpriority="high" decoding="async" />
    </picture>
    <video id="hero-video" muted loop playsinline preload="none"
      data-portrait={has('hero-portrait.mp4') ? href('/media/hero-portrait.mp4') : undefined}
      data-small={has('hero-720.mp4') ? href('/media/hero-720.mp4') : undefined}
      data-av1={has('hero.av1.mp4') ? href('/media/hero.av1.mp4') : undefined}
      data-full={has('hero.mp4') ? href('/media/hero.mp4') : undefined}></video>
  </div>

  <div class="container welcome-grid">
    <div class="welcome-text">
      <p class="chip-open"><TodayHours prefix="Bar open today" fallback="Members and their guests welcome" /></p>
      <h1 id="welcome-title">Pull up a chair at VFW Post 6493</h1>
      <p class="welcome-lede">The bar, the Loaded Belly kitchen and the hall of the Veterans of Foreign Wars in {POST.city}. Members and their guests are welcome.</p>
      <p class="welcome-motto">{POST.motto}.</p>
      <div class="btn-row">
        <a class="btn btn-brass" href={href('/bar')}>Food and drink</a>
        <a class="btn btn-ghost" href={href('/events')}>What's on</a>
        <a class="btn btn-ghost" href={href('/hall#inquiry')}>Rent the Hall</a>
      </div>
    </div>
    <HeroCarousel />
  </div>

  {sources.length > 0 && (
    <button class="video-toggle" type="button" hidden>
      <span class="icon" aria-hidden="true"></span>
      <span class="sr-only">Pause the background video</span>
    </button>
  )}
</section>

<script is:inline>
  (() => {
    const v = document.getElementById('hero-video');
    if (!v) return;
    const b = document.querySelector('.video-toggle');
    const label = b && b.querySelector('.sr-only');
    const sync = () => { if (!b) return; b.dataset.paused = String(v.paused); label.textContent = v.paused ? 'Play the background video' : 'Pause the background video'; };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator.connection && navigator.connection.saveData);
    // The poster image paints first. The video file is chosen and fetched only after the page has loaded.
    const start = () => {
      const phone = matchMedia('(max-width: 700px)').matches, portrait = matchMedia('(orientation: portrait)').matches;
      const d = v.dataset;
      // Large landscape screens: AV1 first when the browser can play it; others skip to hero.mp4.
      const av1 = !phone && innerWidth >= 1280 && d.av1 && v.canPlayType('video/mp4; codecs="av01.0.12M.10"') ? d.av1 : '';
      const src = av1 || (phone ? ((portrait && d.portrait) || d.small || d.full) : (d.full || d.small));
      if (!src) return;
      v.src = src;
      v.addEventListener('playing', () => v.classList.add('is-on'), { once: true });
      v.play().catch(() => {
        const go = () => v.play().catch(() => {});
        addEventListener('touchend', go, { once: true, passive: true });
        addEventListener('click', go, { once: true });
      });
    };
    if (b) {
      b.hidden = false;
      b.addEventListener('click', () => {
        if (!v.src && !v.currentSrc) start();
        else if (v.paused) v.play(); else v.pause();
      });
      v.addEventListener('play', sync);
      v.addEventListener('pause', sync);
      sync();
    }
    if (still) { sync(); return; }
    const go = () => setTimeout(start, 300);
    if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
  })();
</script>

<style>
  .welcome {
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--night); color: var(--on-dark);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
    min-height: min(44rem, calc(100svh - var(--header-h) - 24px));
    display: grid; align-items: center;
  }
  .welcome-media, .welcome-media video, .welcome-poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .welcome-poster { object-fit: cover; }
  .welcome-media video { opacity: 0; transition: opacity 0.6s; }
  .welcome-media video.is-on { opacity: 1; }
  .welcome-media { z-index: -1; }
  .welcome-media video { object-fit: cover; }
  /* Warm, candle-lit scrim: >= 0.8 behind all hero text (on-dark >= 7:1, brass >= 4:1 over a white frame). */
  .welcome-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(23 18 14 / 0.9) 0, rgb(23 18 14 / 0.76) 48%, rgb(23 18 14 / 0.3) 100%),
      linear-gradient(0deg, rgb(23 18 14 / 0.35), rgb(23 18 14 / 0.35)),
      radial-gradient(70% 60% at 85% 20%, rgb(214 160 90 / 0.18), transparent 70%);
  }
  @media (max-width: 899px) { .welcome-media::after { background: linear-gradient(180deg, rgb(23 18 14 / 0.78), rgb(23 18 14 / 0.88)); } }
  .welcome-media::before {
    content: ''; position: absolute; inset: auto 0 0; height: 6px; z-index: 1;
    background: linear-gradient(var(--red) 0 2px, var(--on-dark) 2px 4px, var(--red) 4px);
  }

  .welcome-grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 1100px) { .welcome-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); column-gap: 4rem; } }
  .welcome-text { max-width: 38rem; }
  .welcome-text h1 {
    margin-top: 1.1rem; font-size: clamp(2.6rem, 1.8rem + 3.6vw, 4.6rem); line-height: 1.04; color: var(--on-dark);
    text-shadow: 0 2px 18px rgb(23 18 14 / 0.6);
  }
  .welcome-lede { margin-top: 1rem; font-size: var(--step-1); line-height: 1.5; color: var(--on-dark); max-width: 34ch; }
  .welcome-motto { margin-top: 0.9rem; font-family: var(--font-display); font-style: italic; font-weight: 650; font-size: var(--step-1); color: var(--brass); }
  .welcome .btn-row { margin-top: 1.75rem; }


  .video-toggle {
    position: absolute; left: max(var(--gutter), env(safe-area-inset-left)); bottom: 16px; display: grid; place-items: center; width: 48px; height: 48px;
    border: 2px solid var(--on-dark); border-radius: var(--radius); background: rgb(23 18 14 / 0.7); color: var(--on-dark); cursor: pointer;
  }
  .video-toggle:hover { background: var(--on-dark); color: var(--night); }
  .video-toggle[hidden] { display: none; }
  .welcome:has(.video-toggle:not([hidden])) { padding-bottom: calc(clamp(3.5rem, 2rem + 5vw, 6.5rem) + 84px); }
  .icon { width: 12px; height: 14px; border-inline: 4px solid currentColor; }
  [data-paused='true'] .icon { width: 0; height: 0; margin-left: 4px; border: 0; border-block: 8px solid transparent; border-left: 13px solid currentColor; }
  @media print { .welcome { background: none; color: #000; min-height: 0; } }
</style>
