---
import { POST, href } from '../lib/site';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <video id="hero-video" autoplay muted loop playsinline preload="metadata" poster={href('/media/hero-poster.jpg')} data-poster-portrait={href('/media/hero-poster-portrait.jpg')}>
      <source media="(max-width: 700px) and (orientation: portrait)" src={href('/media/hero-portrait.mp4')} type="video/mp4" />
      <source media="(max-width: 700px)" src={href('/media/hero-720.mp4')} type="video/mp4" />
      <source src={href('/media/hero.mp4')} type="video/mp4" />
    </video>
    <script is:inline>
      // Portrait phones get the 9:16 file, so give them its poster too (video poster has no media attribute).
      // The video plays under reduced motion too; the zoom stays off and the pause button is always there.
      const v0 = document.getElementById('hero-video');
      if (matchMedia('(max-width: 700px) and (orientation: portrait)').matches) v0.poster = v0.dataset.posterPortrait;
    </script>
  </div>

  <div class="container hero-content">
    <p class="eyebrow fade-up">{POST.city}, {POST.region}</p>
    <h1 id="hero-title" class="hero-title fade-up" style="--i:1">VFW Post 6493 &amp; Auxiliary</h1>
    <p class="hero-sub motto fade-up" style="--i:2">{POST.motto}</p>
    <div class="btn-row fade-up" style="--i:3">
      <a class="btn btn-brass" href={href('/bar')}>The Bar</a>
      <a class="btn btn-ghost" href={href('/events')}>Events</a>
      <a class="btn btn-ghost" href={href('/hall')}>Rent the Hall</a>
    </div>
  </div>

  <div class="hero-strip">
    <div class="container strip-inner">
      <p class="strip-times">
        <a class="strip-bar" href={href('/bar')}>Bar hours and specials</a>
        <a class="strip-tel" href={POST.tel}>{POST.phone}</a>
      </p>
      <a class="strip-addr" href={POST.mapsUrl} rel="noopener">{POST.address}</a>
      <button class="video-toggle" type="button" hidden>
        <span class="icon" aria-hidden="true"></span>
        <span class="sr-only">Pause background video</span>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const v = document.getElementById('hero-video');
    const b = document.querySelector('.video-toggle');
    if (!v || !b) return;
    const label = b.querySelector('.sr-only');
    const sync = () => {
      b.dataset.paused = String(v.paused);
      label.textContent = v.paused ? 'Play background video' : 'Pause background video';
    };
    b.hidden = false;
    b.addEventListener('click', () => (v.paused ? v.play() : v.pause()));
    v.addEventListener('play', sync);
    v.addEventListener('pause', sync);
    sync();
    // iPhone Low Power Mode / Android Data Saver block autoplay: start on the visitor's first tap instead.
    v.play().catch(() => {
      const go = () => v.play().catch(() => {});
      addEventListener('touchend', go, { once: true, passive: true });
      addEventListener('click', go, { once: true });
    });
  })();
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-rows: 1fr auto; grid-template-columns: minmax(0, 1fr);
    min-height: clamp(600px, 100svh, 900px);
    background: var(--night); color: var(--on-dark);
  }
  .hero-media, .hero-media video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-media { z-index: -1; }
  .hero-media video { object-fit: cover; }
  .hero-media::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(18 25 33 / 0.72) 0, rgb(18 25 33 / 0.25) 70%),
      linear-gradient(180deg, rgb(18 25 33 / 0.55) 0, transparent 30%, rgb(18 25 33 / 0.85) 100%);
  }
  .hero-content { align-self: end; padding-top: calc(var(--header-h) + 2.5rem); padding-bottom: clamp(2rem, 1rem + 4vw, 4rem); }
  .hero .eyebrow { color: var(--brass); }
  .hero-title {
    margin-top: 1rem; max-width: 14ch; color: var(--on-dark);
    font-size: clamp(2.6rem, 1.8rem + 3.4vw, 4.75rem); line-height: 1.05;
  }
  .hero-sub { margin-top: 1.1rem; font-size: var(--step-2); color: var(--brass); }
  .hero .btn-row { margin-top: 2rem; }

  .hero-strip { position: relative; border-top: 1px solid rgb(194 171 114 / 0.3); background: rgb(18 25 33 / 0.6); }
  .strip-inner { display: flex; align-items: center; gap: 1rem 2rem; min-height: 76px; padding-block: 0.9rem; }
  .strip-times { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.25rem; margin-right: auto; }
  .strip-bar { display: inline-flex; align-items: center; min-height: 44px; color: var(--on-dark); text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 5px; }
  .strip-tel { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); color: var(--on-dark); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .strip-addr { display: none; color: var(--on-dark); text-decoration: underline; text-decoration-color: var(--brass); text-underline-offset: 5px; }
  .video-toggle {
    flex-shrink: 0; display: grid; place-items: center; width: 48px; height: 48px;
    border: 2px solid var(--on-dark); border-radius: var(--radius); background: transparent; color: var(--on-dark); cursor: pointer;
  }
  .video-toggle:hover { background: var(--on-dark); color: var(--night); }
  .video-toggle[hidden] { display: none; }
  .icon { width: 12px; height: 14px; border-inline: 4px solid currentColor; }
  [data-paused='true'] .icon { width: 0; height: 0; margin-left: 4px; border: 0; border-block: 8px solid transparent; border-left: 13px solid currentColor; }
  @media (min-width: 900px) { .strip-addr { display: inline; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-media video { animation: settle 16s var(--ease) both; }
    @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }
  }
  @media (max-width: 699px) { .hero { min-height: max(560px, calc(100svh - var(--bar-h))); } }
</style>
