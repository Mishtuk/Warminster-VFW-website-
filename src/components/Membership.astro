---
/** Membership: shown once, on /about (#membership). Home links here from the board. */
import { POST } from '../lib/site';
---
<section class="section band-stone" id="membership">
  <div class="container split">
    <div>
      <h2 class="bars">Join the post</h2>
      <p class="lede" style="margin-top:1rem">{POST.membership}</p>
    </div>
    <div class="stack">
      <p>{POST.joinPrice}</p>
      <p><a class="btn" href={POST.tel}>Call {POST.phone}</a></p>
    </div>
  </div>
</section>
