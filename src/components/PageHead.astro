---
/**
 * Inner-page head: the page's title on paper, closed by a double rule, like the header of a typed record.
 * image: photo name such as "hall-02" (optional); it hangs as a framed print beside the title on desktop.
 */
import { photo } from '../lib/site';
interface Props { eyebrow?: string; title: string; lede?: string; image?: string; focus?: string }
const { eyebrow, title, lede, image, focus = 'center' } = Astro.props;
---
<section class="page-head">
  <div class:list={['container', { 'has-media': image }]}>
    <div class="page-head-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {image && (
      <div class="page-head-media snap" aria-hidden="true">
        <img {...photo(image)} sizes="(min-width: 900px) 40vw, 100vw" alt="" fetchpriority="high" decoding="async" style={`object-position:${focus}`} />
      </div>
    )}
  </div>
</section>
