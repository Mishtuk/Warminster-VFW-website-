---
import { POST, NAV, EXTRA, href } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <hr class="flag-stripe" aria-hidden="true" />
  <div class="container foot-grid">
    <div class="foot-id">
      <a href={href('/')} aria-label={`${POST.name} home`}><img src={href('/brand/logo-reverse.svg')} alt="" width="240" height="123" loading="lazy" /></a>
      <p class="foot-name">{POST.name}</p>
      <address>{POST.street}<br />{POST.city}, {POST.region} {POST.zip}</address>
      <a class="phone" href={POST.tel}>{POST.phone}</a>
      <p><a class="link" href={POST.mapsUrl} rel="noopener">Directions</a></p>
    </div>

    <div class="foot-hours">
      <h2 class="fh">Bar hours</h2>
      <dl>
        {POST.hours.map(([d, h]) => <div><dt>{d}</dt><dd>{h}</dd></div>)}
      </dl>
      <p class="foot-note">{POST.barRule}</p>
    </div>

    <nav class="foot-nav" aria-label="Footer">
      <h2 class="fh">Pages</h2>
      <ul>
        {NAV.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
        {EXTRA.map((l) => <li><a href={href(l.path)}>{l.label}</a></li>)}
        <li><a href={href('/about#join')}>Join the post</a></li>
        <li><a href={POST.facebook} rel="noopener">Facebook group</a></li>
      </ul>
    </nav>
  </div>

  <div class="container foot-bottom">
    <p>&copy; {year} {POST.name}, {POST.city}, {POST.region}</p>
    <a class="staff" href={href('/admin')} rel="nofollow">Admin login</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--night); color: var(--on-dark); }
  .flag-stripe { margin: 0; }
  .foot-grid { display: grid; gap: 2.5rem; padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  @media (min-width: 900px) { .foot-grid { grid-template-columns: 1.1fr 1fr 1fr; gap: 3.5rem; } }

  .foot-id img { width: 15rem; height: auto; }
  .foot-name { margin-top: 1.25rem; font-family: var(--font-display); font-stretch: 80%; font-weight: 750; font-size: var(--step-1); }
  address { font-style: normal; margin-top: 0.4rem; color: var(--on-dark-2); }
  .phone { display: inline-flex; align-items: center; min-height: 48px; font-family: var(--font-display); font-stretch: 80%; font-weight: 750; font-size: var(--step-2); text-decoration: none; }
  .phone:hover { color: var(--brass); }

  .fh { font-family: var(--font-ui); font-stretch: 100%; font-weight: 700; font-size: var(--step-0); color: var(--brass); margin-bottom: 0.5rem; }
  dl { font-family: var(--font-ui); }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.55rem; border-top: 1px solid rgb(236 238 233 / 0.14); }
  dt { font-weight: 650; }
  dd { color: var(--on-dark-2); text-align: right; }
  .foot-note { margin-top: 0.9rem; color: var(--on-dark-2); font-size: var(--step--1); }

  ul { list-style: none; padding: 0; columns: 2; column-gap: 1.5rem; }
  .foot-nav a { display: flex; align-items: center; min-height: 44px; font-family: var(--font-ui); font-weight: 600; text-decoration: none; }
  .foot-nav a:hover { color: var(--brass); text-decoration: underline 2px; text-underline-offset: 5px; }

  .foot-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem;
    padding-block: 1.25rem calc(1.75rem + env(safe-area-inset-bottom)); border-top: 1px solid rgb(236 238 233 / 0.14);
    color: var(--on-dark-2); font-family: var(--font-ui); font-size: var(--step--1);
  }
  .staff { display: inline-flex; align-items: center; min-height: 44px; color: var(--on-dark-2); text-decoration: underline; text-underline-offset: 4px; }
  .staff:hover { color: var(--on-dark); }
</style>
