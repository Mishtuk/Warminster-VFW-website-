---
// A drawn arrow for Previous/Next buttons, so it looks the same on every device (text arrows vary by font). Inherits the button colour.
const { dir = 'right', size = 22 } = Astro.props as { dir?: 'left' | 'right'; size?: number };
---
<svg class="arrow" aria-hidden="true" focusable="false" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
  {dir === 'left' ? <path d="M19 12H5M11 6l-6 6 6 6" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
