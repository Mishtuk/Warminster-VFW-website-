---
/** Phone-only bottom action bar (<700px): Call, Directions, Hall, Facebook. */
import { POST, href } from '../lib/site';
const here = Astro.url.pathname.replace(/\/$/, '');
---

<nav class="mobile-bar" aria-label="Quick actions">
  <a href={POST.tel}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
    <span>Call</span>
  </a>
  <a href={POST.mapsUrl} rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></svg>
    <span>Directions</span>
  </a>
  <a href={href('/hall#inquiry')} aria-current={here === href('/hall') ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20H4z" /><path d="M10 20v-5h4v5" /></svg>
    <span>Hall</span>
  </a>
  <a href={POST.facebook} rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="9" r="3" /><circle cx="17" cy="10" r="2.3" /><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5M15.5 14.4c3 0 5 1.6 5 4.6" /></svg>
    <span>Facebook</span>
  </a>
</nav>

<style>
  .mobile-bar { display: none; }
  @media (max-width: 699px) {
    .mobile-bar {
      position: fixed; inset: auto 0 0; z-index: 45; display: grid; grid-template-columns: repeat(4, 1fr);
      height: calc(var(--bar-h) + env(safe-area-inset-bottom)); padding: 0 max(0.25rem, env(safe-area-inset-right)) env(safe-area-inset-bottom) max(0.25rem, env(safe-area-inset-left));
      background: var(--night); border-top: 2px solid var(--brass);
    }
    .mobile-bar a {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
      min-height: 56px; color: var(--on-dark); text-decoration: none; font-size: 1.0625rem; font-weight: 600; --focus: var(--brass);
    }
    .mobile-bar svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linejoin: round; stroke-linecap: round; }
    .mobile-bar a:active, .mobile-bar a[aria-current='page'] { color: var(--brass); }
  }
  @media print { .mobile-bar { display: none; } }
</style>
