---
/**
 * Hero photo stack: pinned snapshots from different post events. Every page load shows a random 9 from a bank of 22.
 * An inline script picks them and builds the stack before first paint and starts loading photo 1 straight away (low priority, so the poster stays the LCP).
 * Photos 2 to 9 load in the background after the page has loaded. Every 5.5 s the top one slides away and the next settles in;
 * auto-cycling stops on hover or focus, when the tab is hidden, on the Pause button, and always under reduced motion.
 * Clicking a photo opens the viewer with the whole set (data-gallery="hero").
 */
import { photo, href } from '../lib/site';
import { HERO_BANK } from '../lib/hero-photos';

const bank = HERO_BANK.map((p) => ({
  thumb: photo(p.name).src,
  small: photo(p.name).srcset.split(' ')[0],
  full: href(`/media/photos/${p.name}-full.webp`),
  alt: p.alt, cap: p.cap,
}));
const first = bank[0];
---
<div class="car" data-gallery="hero" role="group" aria-roledescription="carousel" aria-label="Photos from events at the post">
  <ol class="car-stack">
    <noscript>
      <li class="car-slide" data-pos="0">
        <figure class="snap" style="--tilt:-1.4deg"><img src={first.small} width="1024" height="768" alt={first.alt} /><figcaption>{first.cap}</figcaption></figure>
      </li>
    </noscript>
  </ol>
  <div class="car-ctrl">
    <button type="button" class="car-btn car-prev" aria-label="Previous photo"><span aria-hidden="true">&#8592;</span></button>
    <button type="button" class="car-btn car-play" aria-label="Pause the photo slideshow"><span class="car-ico" aria-hidden="true"></span></button>
    <button type="button" class="car-btn car-next" aria-label="Next photo"><span aria-hidden="true">&#8594;</span></button>
    <span class="car-count">1 of 9</span>
  </div>
  <p class="sr-only car-live" aria-live="off"></p>
  <script type="application/json" id="car-bank" set:html={JSON.stringify(bank)}></script>
  <!-- Runs while the page is parsed, before first paint: pick 9 at random, build the stack, start photo 1. -->
  <script is:inline>
    (function () {
      var root = document.querySelector('.car');
      var raw = document.getElementById('car-bank');
      if (!root || !raw) return;
      var bank = JSON.parse(raw.textContent);
      for (var i = bank.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = bank[i]; bank[i] = bank[j]; bank[j] = t; }
      var pick = bank.slice(0, 9);
      var tilts = ['-1.4deg', '1.2deg', '-0.8deg', '1.6deg', '-1.1deg', '0.9deg', '-1.5deg', '1.3deg', '-0.7deg'];
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
      var html = pick.map(function (p, i) {
        var img = i === 0
          ? '<img src="' + esc(p.small) + '" fetchpriority="low" decoding="async" '
          : '<img data-src="' + esc(p.small) + '" decoding="async" ';
        return '<li class="car-slide" data-pos="' + i + '"><figure class="snap" style="--tilt:' + tilts[i] + '">' + img + 'width="1024" height="768" alt="' + esc(p.alt) + '" /><figcaption>' + esc(p.cap) + '</figcaption></figure></li>';
      }).join('');
      root.querySelector('.car-stack').innerHTML = html;
      var list = document.createElement('script');
      list.type = 'application/json';
      list.setAttribute('data-gallery-list', 'hero');
      list.textContent = JSON.stringify(pick.map(function (p) { return { src: p.full, thumb: p.thumb, alt: p.alt, cap: p.cap }; }));
      root.appendChild(list);
      root.querySelector('.car-count').textContent = '1 of ' + pick.length;
    })();
  </script>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.car');
  if (root) {
    // Phones: the stack leaves the hero and becomes a compact strip right after it.
    const mq = matchMedia('(max-width: 699px)');
    const anchor = document.createComment('car');
    root.before(anchor);
    let strip: HTMLElement | null = null;
    const relocate = () => {
      if (mq.matches) {
        if (!strip) {
          strip = document.createElement('section');
          strip.className = 'car-strip';
          strip.setAttribute('aria-label', 'Photos from events at the post');
          const c = document.createElement('div');
          c.className = 'container';
          strip.appendChild(c);
          document.querySelector('.welcome')?.after(strip);
        }
        strip.firstElementChild!.appendChild(root);
      } else {
        anchor.after(root);
        strip?.remove();
        strip = null;
      }
    };
    relocate();
    mq.addEventListener('change', relocate);
    const slides = [...root.querySelectorAll<HTMLElement>('.car-slide')];
    const n = slides.length;
    if (n) {
      const live = root.querySelector('.car-live') as HTMLElement;
      const count = root.querySelector('.car-count') as HTMLElement;
      const play = root.querySelector('.car-play') as HTMLButtonElement;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = 0, timer = 0, userPaused = reduced, hovering = false;

      const place = (announce: boolean) => {
        slides.forEach((s, i) => {
          const pos = (i - cur + n) % n;
          s.dataset.pos = String(pos === n - 1 ? 'out' : pos);
          s.toggleAttribute('inert', pos !== 0);
        });
        const cap = slides[cur].querySelector('figcaption')?.textContent ?? '';
        count.textContent = `${cur + 1} of ${n}`;
        live.setAttribute('aria-live', announce ? 'polite' : 'off');
        live.textContent = announce ? `Photo ${cur + 1} of ${n}: ${cap}` : '';
      };
      const go = (to: number, announce = false) => { cur = (to + n) % n; place(announce); };
      const sync = () => {
        clearTimeout(timer);
        play.setAttribute('aria-label', userPaused ? 'Play the photo slideshow' : 'Pause the photo slideshow');
        play.dataset.paused = String(userPaused);
        if (!userPaused && !hovering && !document.hidden) timer = window.setTimeout(() => { go(cur + 1); sync(); }, 5500);
      };

      // Photos 2 to 9 load in the background right after the page has loaded.
      const loadRest = () => {
        for (const img of root.querySelectorAll<HTMLImageElement>('img[data-src]')) {
          if (!img.getAttribute('src')) img.setAttribute('src', img.dataset.src || '');
        }
      };
      if (document.readyState === 'complete') setTimeout(loadRest, 200); else addEventListener('load', () => setTimeout(loadRest, 200), { once: true });

      root.querySelector('.car-prev')!.addEventListener('click', () => { go(cur - 1, true); sync(); });
      root.querySelector('.car-next')!.addEventListener('click', () => { go(cur + 1, true); sync(); });
      play.addEventListener('click', () => { userPaused = !userPaused; sync(); });
      root.addEventListener('mouseenter', () => { hovering = true; sync(); });
      root.addEventListener('mouseleave', () => { hovering = false; sync(); });
      root.addEventListener('focusin', () => { hovering = true; sync(); });
      root.addEventListener('focusout', () => { hovering = false; sync(); });
      document.addEventListener('visibilitychange', sync);
      // Swipe on phones
      let x0 = 0, y0 = 0;
      root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
      root.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) { go(cur + (dx < 0 ? 1 : -1), true); sync(); }
      }, { passive: true });

      if (reduced) { play.hidden = true; root.classList.add('is-still'); }
      place(false);
      sync();
    }
  }
</script>

<style is:global>
  /* Global on purpose: the slides are created by the inline script, so they carry no scoped attribute. All selectors start with .car. */
  .car { width: min(100%, 22rem); margin-inline: auto; }
  .car-stack { position: relative; list-style: none; padding: 0; margin: 0; aspect-ratio: 1 / 0.98; }
  .car-slide {
    position: absolute; inset: 0 8% 4% 8%; transform-origin: 50% 90%;
    transition: transform 0.9s cubic-bezier(0.22, 0.8, 0.3, 1), opacity 0.7s ease;
    opacity: 0; transform: scale(0.9);
  }
  .car-slide figure { margin: 0; }
  .car-slide[data-pos='0'] { opacity: 1; transform: none; z-index: 4; }
  .car-slide[data-pos='1'] { opacity: 1; transform: translate(6%, 3%) rotate(5deg) scale(0.97); z-index: 3; }
  .car-slide[data-pos='2'] { opacity: 1; transform: translate(-6%, 5%) rotate(-5deg) scale(0.94); z-index: 2; }
  .car-slide[data-pos='out'] { opacity: 0; transform: translate(70%, -6%) rotate(16deg); z-index: 5; }
  .car-slide[data-pos='1'] figcaption, .car-slide[data-pos='2'] figcaption { visibility: hidden; }
  .car-slide figcaption { min-height: 2.9em; }
  .is-still .car-slide { transition: none; }
  @media (prefers-reduced-motion: reduce) { .car-slide { transition: none; } }

  .car-ctrl { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.75rem; color: var(--on-dark); }
  .car-btn {
    display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 2px solid var(--on-dark); border-radius: var(--radius); background: rgb(23 18 14 / 0.6); color: var(--on-dark); font-size: 1.25rem; cursor: pointer;
  }
  .car-btn:hover { background: var(--on-dark); color: var(--night); }
  .car-btn[hidden] { display: none; }
  .car-ico { width: 12px; height: 14px; border-inline: 4px solid currentColor; }
  .car-play[data-paused='true'] .car-ico { width: 0; height: 0; margin-left: 4px; border: 0; border-block: 8px solid transparent; border-left: 13px solid currentColor; }
  .car-count { margin-left: auto; font-weight: 700; font-size: var(--step--1); }

  /* Phones: hidden in the hero until the script has moved it into the strip below */
  @media (max-width: 699px) { .welcome .car { display: none; } }
  .car-strip { overflow: hidden; background: var(--night); color: var(--on-dark); padding-block: 1.5rem 1.25rem; border-bottom: 6px solid var(--red); }
  .car-strip .car { width: min(100%, 13rem); }
</style>