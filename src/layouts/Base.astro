---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { POST } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string; // path under public/, e.g. "brand/og.jpg"
  /** Transparent header over the home hero. */
  overlay?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description = `${POST.name} in ${POST.city}, PA. ${POST.motto}. The bar, events, hall rental, programs and veteran resources.`,
  image = 'brand/og.jpg',
  overlay = false,
} = Astro.props;

const full = title.startsWith('VFW') ? title : `${title} | ${POST.short}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(`${base}/${image}`, Astro.site);

// Self-hosted fonts (latin subset). Inline so URLs follow the BASE env switch.
const range = 'unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, style: string, weight: string, file: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${base}/fonts/${file}.woff2) format('woff2');${range}}`;
const fontCss = [
  face('Bitter', 'normal', '100 900', 'bitter'),
  face('Public Sans', 'normal', '100 900', 'publicsans'),
  face('Public Sans', 'italic', '100 900', 'publicsans-italic'),
  "@font-face{font-family:'Bitter Fallback';src:local('Georgia Bold'),local('Georgia-Bold'),local('Georgia');size-adjust:92%;ascent-override:101.6%;descent-override:28.8%;line-gap-override:0%}",
  "@font-face{font-family:'Public Sans Fallback';src:local('Arial');size-adjust:105.6%;ascent-override:90%;descent-override:21.3%;line-gap-override:0%}",
].join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/brand/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/brand/favicon-32.png`} />
    <link rel="icon" href={`${base}/brand/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/brand/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#121921" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={POST.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/bitter.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/publicsans.woff2`} crossorigin />
    <style set:html={fontCss}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main"><slot /></main>
    <Footer />
    <MobileBar />
  </body>
</html>
