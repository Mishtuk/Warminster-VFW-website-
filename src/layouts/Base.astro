---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import ThemeFab from '../components/ThemeFab.astro';
import { POST } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string; // path under public/, e.g. "brand/og.jpg" (1200x630 card; the default)
  /** Share photo name from public/media/photos, e.g. "hall-07" (1024x768). Wins over image. */
  sharePhoto?: string;
  imageAlt?: string;
  /** Transparent header over the home hero. */
  overlay?: boolean;
  /** Kiosk screens (the bar TV): no header, footer or theme button, always dark, hidden from search. */
  bare?: boolean;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const {
  title,
  description = `${POST.name} in ${POST.city}, PA. ${POST.motto}. The bar, events, hall rental, programs and veteran resources.`,
  image = 'brand/og.jpg',
  sharePhoto,
  imageAlt = `${POST.name}, ${POST.city}, PA. ${POST.motto}.`,
  overlay = false,
  bare = false,
} = Astro.props;

const full = title.startsWith('VFW') ? title : `${title} | ${POST.short}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = sharePhoto ? `media/photos/${sharePhoto.replace(/.(webp|jpg)$/, '')}.webp` : image;
const [imageW, imageH] = sharePhoto ? [1024, 768] : [1200, 630];
const imageUrl = new URL(`${base}/${imagePath}`, Astro.site);

// Self-hosted fonts (latin subset). Inline so URLs follow the BASE env switch.
const range = 'unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, style: string, weight: string, file: string) =>
  `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(${base}/fonts/${file}.woff2) format('woff2');${range}}`;
const fontCss = [
  // Archivo: one variable file (wght 100-900, wdth 62-125). Headings use font-stretch 80%, UI 100%.
  `@font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;font-display:swap;src:url(${base}/fonts/archivo.woff2) format('woff2');${range}}`,
  face('Literata', 'normal', '200 900', 'literata'),
  // Size-matched local fallbacks limit layout shift during swap (measured with fontTools).
  "@font-face{font-family:'Archivo Fallback';src:local('Arial Bold'),local('Arial-BoldMT'),local('Arial');size-adjust:94.7%;ascent-override:92.8%;descent-override:22.2%;line-gap-override:0%}",
  "@font-face{font-family:'Literata Fallback';src:local('Georgia');size-adjust:108.3%;ascent-override:108.7%;descent-override:28.4%;line-gap-override:0%}",
].join('');
---

<!doctype html>
<html lang="en" data-theme={bare ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Theme before first paint: a saved choice wins; otherwise CSS follows the system setting. -->
    <script is:inline>try{if(!document.documentElement.dataset.theme){var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}}catch(e){}</script>
    <meta name="color-scheme" content="light dark" />
    <title>{full}</title>
    {bare && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/brand/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/brand/favicon-32.png`} />
    <link rel="icon" href={`${base}/brand/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/brand/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <meta name="theme-color" content="#17120e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={POST.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={imageW} />
    <meta property="og:image:height" content={imageH} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/archivo.woff2`} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={`${base}/fonts/literata.woff2`} crossorigin />
    <style set:html={fontCss}></style>
    <slot name="head" />
  </head>
  <body>
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header overlay={overlay} />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    {!bare && <Lightbox />}
    {!bare && <ThemeFab />}
  </body>
</html>
